---
import type { CollectionEntry } from 'astro:content';
import { categoryLabel, formatPostDate } from '../lib/blog-categories';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
---

<article class="blog-card" data-tag={post.data.category}>
	<div class="blog-card-media">
		{
			post.data.image ? (
				<img src={post.data.image} alt={post.data.imageAlt ?? ''} class="blog-card-img" />
			) : (
				<div class="blog-card-placeholder"></div>
			)
		}
	</div>
	<div class="blog-meta">
		<a href={`/blog#${post.data.category}`} class="blog-meta-tag">{categoryLabel(post.data.category)}</a>
		<span class="blog-meta-date">{formatPostDate(post.data.pubDate)}</span>
	</div>
	<h3 class="blog-card-title">{post.data.title}</h3>
	<p class="blog-card-teaser">{post.data.description}</p>
	<a href={`/blog/${post.slug}`} class="blog-btn-ghost">Artikel lesen</a>
</article>

<style is:global>
	.blog-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		min-height: 0;
	}

	.blog-card-media {
		aspect-ratio: 3 / 2;
		background-color: var(--emerald);
		margin-bottom: 1.5rem;
		transition: transform 0.4s ease;
		overflow: hidden;
		border-radius: 0.75rem;
	}

	.blog-card:hover .blog-card-media {
		transform: scale(1.03);
	}

	.blog-card .blog-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
		font-family: 'Manrope', system-ui, sans-serif;
		font-size: 12px;
	}

	.blog-meta-tag {
		font-family: 'Manrope', system-ui, sans-serif;
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		color: var(--gold);
		text-decoration: none;
	}

	.blog-meta-tag:hover {
		opacity: 0.85;
	}

	.blog-meta-date {
		color: var(--muted);
		font-weight: 300;
	}

	.blog-card-title {
		font-family: 'Manrope', system-ui, sans-serif;
		font-weight: 700;
		font-size: 18px;
		line-height: 1.25;
		color: var(--text);
		margin: 0 0 0.5rem 0;
	}

	.blog-card-teaser {
		font-family: 'Manrope', system-ui, sans-serif;
		font-weight: 300;
		font-size: 16px;
		line-height: 1.7;
		color: var(--muted);
		margin: 0;
		flex: 1 1 auto;
		min-height: 0;
	}

	.blog-btn-ghost {
		display: inline-block;
		background-color: transparent;
		color: var(--text);
		border: 1px solid rgba(28, 28, 28, 0.2);
		padding: 0.85rem 2rem;
		font-family: 'Manrope', system-ui, sans-serif;
		font-weight: 700;
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		text-decoration: none;
		transition: border-color 0.25s ease;
		border-radius: 9999px;
		margin-top: 1.5rem;
		flex-shrink: 0;
		align-self: flex-start;
	}

	.blog-btn-ghost:hover {
		border-color: var(--text);
	}

	.blog-card-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.blog-card-placeholder {
		width: 100%;
		height: 100%;
		background-color: var(--emerald);
	}
</style>
