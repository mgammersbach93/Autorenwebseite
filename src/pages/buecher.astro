---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ogImageSrc from '../images/Feature_buecher.png';
import coverGluecklich from '../images/sie-wollten-doch-nur-gluecklich-sein.jpg';
import coverNeuesWagen from '../images/sie-wollten-endlich-neues-wagen.jpg';

const siteOrigin = Astro.site?.origin ?? 'https://mgammersbach.de';
const buecherOg = await getImage({ src: ogImageSrc, width: 1200 });
const ogImageUrl = new URL(buecherOg.src, siteOrigin).href;

const books: {
	title: string;
	subtitle: string | null;
	description: string;
	cover: ImageMetadata;
	slug: string;
	cta: string;
	buttonClass: string;
}[] = [
	{
		title: 'Sie wollten doch nur glücklich sein',
		subtitle: null,
		description:
			'Vier Millennials, vier Probleme und ein Workshop. Die Suche nach Glück trifft auf das Hochwasser im Rheinland.',
		cover: coverGluecklich,
		slug: '/gluecklich-sein/',
		cta: 'Zu Teil 1',
		buttonClass: 'btn-primary',
	},
	{
		title: 'Sie wollten endlich Neues wagen',
		subtitle: null,
		description:
			'Neue Wege, neue Erfolge und neue Probleme. Die vier Millennials trauen sich heraus aus ihrer Komfortzone.',
		cover: coverNeuesWagen,
		slug: '/neues-wagen/',
		cta: 'Zu Teil 2',
		buttonClass: 'btn-orange',
	},
];
---

<Layout
	title="Bücher von Markus Gammersbach | Romane für Millennials"
	description="Entdecke die Romanreihe von Markus Gammersbach. Geschichten über Millennials, persönliches Wachstum und den Mut, Neues zu wagen."
	image={ogImageUrl}
>
	<!-- Full viewport Smaragd header -->
	<section class="buecher-hero">
		<div class="buecher-hero-inner">
			<h1 class="buecher-hero-title">Meine Bücher</h1>
			<p class="buecher-hero-intro">
				<span class="buecher-hero-intro-line">Geschichten, die dich weiterbringen.</span>{' '}
				<span class="buecher-hero-intro-line">Hol dir neue Inspiration für deinen Alltag!</span>
			</p>
		</div>
	</section>

	<!-- Book list: max-width 1300px centered -->
	<section class="buecher-list">
		<div class="container buecher-list-inner">
			<div class="book-grid">
				{books.map((book) => (
					<article class="book-card">
						<a href={book.slug} class="book-cover-wrap">
							{book.cover ? (
								<Image src={book.cover} alt="" class="book-cover-img" width={900} />
							) : (
								<div class="book-cover-placeholder" aria-hidden="true"></div>
							)}
						</a>
						<div class="book-card-body">
							<h2 class="book-title">{book.title}</h2>
							{book.subtitle && <p class="book-subtitle">{book.subtitle}</p>}
							<p class="book-description">{book.description}</p>
							<a href={book.slug} class={`btn ${book.buttonClass} book-cta`}>
								{book.cta}
							</a>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>
</Layout>

<style>
	/* Buttons – same as home */
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: auto;
		padding: 0.85rem 2rem;
		font-family: 'Manrope', sans-serif;
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		border-radius: 9999px;
		cursor: pointer;
		transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
		text-decoration: none;
		white-space: nowrap;
		box-sizing: border-box;
	}

	.btn-primary {
		background-color: var(--btn-primary);
		color: var(--bg);
		border: none;
	}

	.btn-primary:hover {
		background-color: var(--btn-primary-hover);
	}

	.btn-orange {
		background-color: #c13a00;
		color: var(--bg);
		border: none;
	}

	.btn-orange:hover {
		background-color: #a83200;
	}

	/* Full viewport Smaragd header */
	.buecher-hero {
		width: 100vw;
		margin-left: calc(50% - 50vw);
		background-color: var(--emerald);
		color: var(--bg);
		padding-block: 5rem;
		padding-inline: 2rem;
		box-sizing: border-box;
		margin-bottom: 0;
	}

	@media (min-width: 961px) {
		.buecher-hero {
			padding-inline: var(--page-padding-desktop);
			padding-block: 6rem;
		}
	}

	.buecher-hero-inner {
		max-width: 42rem;
		margin-inline: auto;
		text-align: center;
	}

	.buecher-hero-title {
		font-family: 'Manrope', sans-serif;
		font-size: clamp(2rem, 3vw, 2.6rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		margin: 0 0 var(--space-3);
		color: var(--bg);
		text-align: center;
	}

	.buecher-hero-intro {
		font-family: 'Manrope', sans-serif;
		font-size: 16px;
		font-weight: 300;
		line-height: 1.7;
		margin: 0;
		color: var(--bg);
		opacity: 0.9;
		text-align: center;
	}

	@media (max-width: 768px) {
		.buecher-hero-intro-line {
			display: block;
		}

		.buecher-hero-intro-line + .buecher-hero-intro-line {
			margin-top: 0.35em;
		}
	}

	/* Book list section */
	.buecher-list {
		background-color: var(--bg);
		padding-block: 5rem 6rem;
	}

	.buecher-list-inner {
		/* container already has max-width 1300px */
	}

	.book-grid {
		display: grid;
		gap: var(--space-6);
	}

	@media (min-width: 961px) {
		.book-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 4rem var(--space-6);
		}
	}

	.book-card {
		display: grid;
		gap: var(--space-4);
		grid-template-columns: 1fr;
		align-items: start;
		min-width: 0;
	}

	@media (min-width: 720px) {
		.book-card {
			grid-template-columns: 200px 1fr;
			gap: var(--space-5);
		}
	}

	@media (min-width: 961px) {
		.book-card {
			grid-template-columns: 220px 1fr;
		}
	}

	.book-cover-wrap {
		display: block;
		text-decoration: none;
		color: inherit;
		transition: opacity 0.2s ease;
		min-width: 0;
	}

	.book-cover-wrap:hover {
		opacity: 0.9;
	}

	.book-cover-wrap picture {
		display: block;
		width: 100%;
	}

	.book-cover-placeholder {
		width: 100%;
		aspect-ratio: 2 / 3;
		background-color: var(--muted);
		opacity: 0.35;
	}

	.book-cover-img {
		width: 100%;
		height: auto;
		display: block;
		opacity: 1;
	}

	.book-card-body {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.book-title,
	.book-subtitle {
		display: none;
	}

	.book-title {
		font-family: 'Manrope', sans-serif;
		font-size: clamp(1.35rem, 2vw, 1.6rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		margin: 0;
		color: var(--text);
	}

	.book-subtitle {
		font-family: 'Manrope', sans-serif;
		font-size: 13px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--muted);
		margin: 0;
	}

	.book-description {
		font-family: 'Manrope', sans-serif;
		font-size: 16px;
		font-weight: 300;
		line-height: 1.7;
		margin: 0;
		color: var(--muted);
		flex: 1;
	}

	.book-cta {
		width: fit-content;
		margin-top: var(--space-2);
	}

	@media (max-width: 960px) {
		.buecher-hero {
			padding-inline: 2rem;
		}

		.book-grid {
			gap: 6.5rem;
		}
	}

	@media (max-width: 720px) {
		.buecher-list {
			padding-block: 3rem 4rem;
		}

		.book-grid {
			gap: 9rem;
		}

		.book-card {
			grid-template-columns: 1fr;
			text-align: center;
		}

		.book-cover-wrap {
			max-width: 180px;
			margin-inline: auto;
		}

		.book-cta {
			margin-inline: auto;
		}
	}
</style>
