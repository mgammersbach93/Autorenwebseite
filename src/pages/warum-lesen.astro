---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Blättern statt scrollen - Warum wir mehr lesen sollten"
	description="Setze auf analoges statt digitales Dopamin. Hier erfährst du, warum Lesen die persönliche Entwicklung fördert."
	image="/images/blaettern-statt-scrollen.png"
>

	<!-- HERO (same structure as Über mich) -->
	<section class="hero">
		<div class="hero__inner">
			<div class="hero__left">
				<span class="eyebrow">Warum Lesen</span>
				<h1 class="hero__name">Blättern statt<br>Scrollen</h1>
				<div class="hero__divider"></div>
				<p class="hero__intro">
					Warum wir viel häufiger zu einem Buch statt zum Handy greifen sollten.
				</p>
			</div>
			<div class="hero__right">
				<div class="hero__right-shape"></div>
				<img
					class="hero__right-photo"
					src="/images/blaettern-statt-scrollen.png"
					alt="Person liest ein Buch"
				/>
			</div>
		</div>
	</section>

	<!-- VERGLEICH: Handy vs. Buch -->
	<section class="lesen-vergleich">
		<div class="vergleich-inner">
			<div class="vergleich-side">
				<span class="vergleich-emoji">📱</span>
				<span class="vergleich-label">⌀ Zeit pro Tag</span>
				<span class="vergleich-value vergleich-value--muted">4-5 Std.</span>
			</div>
			<div class="vergleich-divider"></div>
			<div class="vergleich-side">
				<span class="vergleich-emoji">📖</span>
				<span class="vergleich-label">⌀ Zeit pro Tag</span>
				<span class="vergleich-value">17 Min.</span>
			</div>
		</div>
	</section>

	<!-- GESUNDHEIT -->
	<section class="lesen-section">
		<div class="lesen-section-inner">
			<span class="eyebrow">Körper & Geist</span>
			<h2 class="lesen-section-title">Lesen fördert die Gesundheit</h2>
			<p class="lesen-section-intro">
				Zahlreiche Studien belegen, dass das Lesen von Büchern positive Auswirkungen auf unser Wohlbefinden hat.
			</p>

			<div class="benefit-grid">
				<div class="benefit-item">
					<div class="benefit-icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
						</svg>
					</div>
					<div class="benefit-content">
						<h3 class="benefit-title">Schlaf</h3>
						<p class="benefit-text">Beruhigt den Geist und reguliert den Schlaf-Wach-Zyklus.</p>
					</div>
				</div>

				<div class="benefit-item">
					<div class="benefit-icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
						</svg>
					</div>
					<div class="benefit-content">
						<h3 class="benefit-title">Detox</h3>
						<p class="benefit-text">Weniger blaues Licht und toxische Inhalte auf Social Media.</p>
					</div>
				</div>

				<div class="benefit-item">
					<div class="benefit-icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
							<path d="M13.73 21a2 2 0 0 1-3.46 0"/>
						</svg>
					</div>
					<div class="benefit-content">
						<h3 class="benefit-title">Entspannung</h3>
						<p class="benefit-text">Reduziert Stress durch Ablenkung von belastenden Situationen und Emotionen.</p>
					</div>
				</div>

				<div class="benefit-item">
					<div class="benefit-icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"/>
							<path d="M12 16v-4M12 8h.01"/>
						</svg>
					</div>
					<div class="benefit-content">
						<h3 class="benefit-title">Gehirn</h3>
						<p class="benefit-text">Fördert die Denkfähigkeit, stärkt die Aufmerksamkeit, verbessert das Gedächtnis.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- WUSSTEST DU -->
	<section class="lesen-wusstest">
		<div class="wusstest-inner">
			<p class="wusstest-text">
				<strong>Wusstest du...?</strong><br>
				...dass eine Studie der Yale University School of Public Health herausgefunden hat, dass Menschen, die regelmäßig lesen, bis zu zwei Jahre länger leben?
			</p>
		</div>
	</section>

	<!-- PERSÖNLICHKEIT -->
	<section class="lesen-section">
		<div class="lesen-section-inner">
			<span class="eyebrow">Persönliche Entwicklung</span>
			<h2 class="lesen-section-title">Lesen fördert die Persönlichkeit</h2>
			<p class="lesen-section-intro">
				Wer regelmäßig liest, erhält darüber hinaus neue Möglichkeiten, um sich als Mensch weiterzuentwickeln.
			</p>

			<div class="benefit-grid">
				<div class="benefit-item">
					<div class="benefit-icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
						</svg>
					</div>
					<div class="benefit-content">
						<h3 class="benefit-title">Inspiration</h3>
						<p class="benefit-text">Liefert inspirierende Inhalte und neue Motivation für Veränderung.</p>
					</div>
				</div>

				<div class="benefit-item">
					<div class="benefit-icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"/>
							<polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>
						</svg>
					</div>
					<div class="benefit-content">
						<h3 class="benefit-title">Reflexion</h3>
						<p class="benefit-text">Fördert das Verständnis der eigenen Werte, Gedanken und Gefühle.</p>
					</div>
				</div>

				<div class="benefit-item">
					<div class="benefit-icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
						</svg>
					</div>
					<div class="benefit-content">
						<h3 class="benefit-title">Empathie</h3>
						<p class="benefit-text">Stärkt soziale Fähigkeiten durch das Eintauchen in Emotionen der Charaktere.</p>
					</div>
				</div>

				<div class="benefit-item">
					<div class="benefit-icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
							<path d="M18 20V10M12 20V4M6 20v-6"/>
						</svg>
					</div>
					<div class="benefit-content">
						<h3 class="benefit-title">Wachstum</h3>
						<p class="benefit-text">Ermöglicht, Wissen zu erweitern und sich persönlich zu entwickeln.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="lesen-cta">
		<div class="lesen-cta-inner">
			<h2 class="lesen-cta-title">Worauf wartest du?</h2>
			<p class="lesen-cta-text">
				Hol dir noch heute deine Portion analoges Dopamin.<br>
				Entdecke spannende Geschichten, nahbare Charaktere und hilfreiche Lektionen für dein persönliches Wachstum.
			</p>
			<img
				class="lesen-cta-image"
				src="/images/millennial-workshop-romanreihe.png"
				alt="Romanreihe zum Millennial Workshop"
				loading="lazy"
				decoding="async"
			/>
			<a href="/buecher" class="btn btn-primary">Zu den Büchern</a>
		</div>
	</section>

</Layout>

<style>
	/* ── HERO (aligned with Über mich) ── */
	.hero {
		background: var(--bg);
		min-height: 100vh;
		display: flex;
		align-items: center;
		padding: 8rem 5rem 0;
		position: relative;
		overflow: visible;
	}

	.hero__inner {
		max-width: 1300px;
		width: 100%;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 6rem;
		align-items: center;
		overflow: visible;
	}

	.hero__left {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.eyebrow {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: var(--gold);
	}

	.hero__name {
		font-family: 'Manrope', sans-serif;
		font-size: 64px;
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.02em;
		color: var(--text);
		margin: 0;
	}

	.hero__divider {
		width: 48px;
		height: 2px;
		background: var(--gold);
	}

	.hero__intro {
		font-family: 'Manrope', sans-serif;
		font-size: 16px;
		font-weight: 300;
		line-height: 1.7;
		color: var(--muted);
		max-width: 420px;
		margin: 0;
	}

	.hero__right {
		position: relative;
		height: 520px;
		align-self: center;
		width: 100%;
		max-width: 520px;
		margin-inline: auto;
	}

	.hero__right-shape {
		position: absolute;
		width: min(520px, 100%);
		height: auto;
		aspect-ratio: 520 / 400;
		background: var(--emerald);
		bottom: 0;
		left: 50%;
		transform: translateX(-50%);
		border-radius: 60px 60px 0 0;
	}

	.hero__right-photo {
		position: absolute;
		bottom: 0;
		left: 50%;
		transform: translateX(-50%);
		display: block;
		width: auto;
		height: auto;
		max-height: 580px;
		max-width: min(100%, 520px);
		object-fit: contain;
		object-position: bottom center;
	}

	/* ── VERGLEICH ── */
	.lesen-vergleich {
		background: var(--bg);
		padding: 4rem 0;
	}

	.vergleich-inner {
		max-width: 800px;
		margin: 0 auto;
		padding: 0 2rem;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 3rem;
	}

	.vergleich-side {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		flex: 1;
		max-width: 280px;
	}

	.vergleich-emoji {
		font-size: 2rem;
		line-height: 1;
		margin-bottom: 0.5rem;
	}

	.vergleich-label {
		font-family: 'Manrope', sans-serif;
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.vergleich-value {
		font-family: 'Manrope', sans-serif;
		font-size: 28px;
		font-weight: 700;
		color: var(--emerald);
	}

	.vergleich-value--muted {
		color: var(--text);
	}

	.vergleich-divider {
		width: 1px;
		height: 100px;
		background: var(--gold);
	}

	@media (max-width: 600px) {
		.vergleich-inner {
			gap: 2rem;
		}

		.vergleich-value {
			font-size: 24px;
		}

		.vergleich-divider {
			height: 80px;
		}
	}

	/* ── WUSSTEST DU ── */
	.lesen-wusstest {
		background: var(--emerald);
		padding: 4rem 0;
		width: 100vw;
		margin-left: calc(50% - 50vw);
	}

	.wusstest-inner {
		max-width: 800px;
		margin: 0 auto;
		padding: 0 2rem;
		text-align: center;
	}

	.wusstest-text {
		font-family: 'Manrope', sans-serif;
		font-size: 18px;
		font-weight: 300;
		line-height: 1.7;
		color: var(--bg);
		margin: 0;
	}

	.wusstest-text strong {
		font-weight: 700;
		font-size: 20px;
	}

	/* ── SECTIONS (GESUNDHEIT & PERSÖNLICHKEIT) ── */
	.lesen-section {
		background: var(--bg);
		padding: 5rem 0;
	}

	.lesen-section-inner {
		max-width: 1300px;
		margin: 0 auto;
		padding: 0 5rem;
	}

	.lesen-section-title {
		font-family: 'Manrope', sans-serif;
		font-size: 28px;
		font-weight: 700;
		color: var(--text);
		margin: 0.75rem 0 1rem;
		letter-spacing: -0.02em;
	}

	.lesen-section-intro {
		font-family: 'Manrope', sans-serif;
		font-size: 16px;
		font-weight: 300;
		line-height: 1.7;
		color: var(--muted);
		max-width: 600px;
		margin: 0 0 3rem;
	}

	/* ── BENEFIT GRID (2x2 mit Icons) ── */
	.benefit-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2.5rem 4rem;
	}

	.benefit-item {
		display: flex;
		gap: 1.25rem;
		align-items: flex-start;
	}

	.benefit-icon {
		flex-shrink: 0;
		width: 44px;
		height: 44px;
		border: 1px solid var(--gold);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--gold);
	}

	.benefit-icon svg {
		width: 20px;
		height: 20px;
	}

	.benefit-content {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.benefit-title {
		font-family: 'Manrope', sans-serif;
		font-size: 16px;
		font-weight: 700;
		color: var(--text);
		margin: 0;
	}

	.benefit-text {
		font-family: 'Manrope', sans-serif;
		font-size: 15px;
		font-weight: 300;
		line-height: 1.65;
		color: var(--muted);
		margin: 0;
	}

	/* ── CTA ── */
	.lesen-cta {
		background: var(--bg);
		padding: 5rem 0 6rem;
		text-align: center;
	}

	.lesen-cta-inner {
		max-width: 600px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	.lesen-cta-title {
		font-family: 'Manrope', sans-serif;
		font-size: 28px;
		font-weight: 700;
		color: var(--text);
		margin: 0 0 1rem;
		letter-spacing: -0.02em;
	}

	.lesen-cta-text {
		font-family: 'Manrope', sans-serif;
		font-size: 16px;
		font-weight: 300;
		line-height: 1.7;
		color: var(--muted);
		margin: 0;
	}

	.lesen-cta-image {
		display: block;
		width: 100%;
		max-width: 340px;
		height: auto;
		margin: 0 auto;
		border-radius: 16px;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.85rem 2rem;
		font-family: 'Manrope', sans-serif;
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		text-decoration: none;
		cursor: pointer;
		transition: background-color 0.2s ease;
		border-radius: 9999px;
	}

	.btn-primary {
		background: var(--btn-primary);
		color: var(--bg);
		border: none;
	}

	.btn-primary:hover {
		background: var(--btn-primary-hover);
	}

	/* ── RESPONSIVE ── */
	@media (max-width: 960px) {
		.hero {
			padding: 8rem 2rem 0;
		}

		.lesen-section-inner {
			padding: 0 1.25rem;
		}

		.vergleich-inner,
		.wusstest-inner,
		.lesen-cta-inner {
			padding-left: 1.25rem;
			padding-right: 1.25rem;
		}

		.benefit-grid {
			gap: 2rem 2.5rem;
		}
	}

	/*
		Stack hero at ≤1200px so tablet / square landscape (e.g. iPad) avoids cramped 2-col.
		Extra bottom padding for this layout lives only in the block below — not on wide desktop
		(see min-width: 1201px), otherwise min-width:769px was forcing 8.5rem under the hero here.
	*/
	@media (max-width: 1200px) {
		.hero {
			align-items: center;
			min-height: auto;
			padding: 6rem 2rem 2.5rem;
		}

		.hero__inner {
			grid-template-columns: 1fr;
			gap: 1.5rem;
			text-align: center;
			align-items: center;
		}

		.hero__left {
			align-items: center;
			order: 2;
			gap: 1.25rem;
		}

		.hero__right {
			order: 1;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: flex-end;
			height: auto;
			width: 100%;
			align-self: center;
		}

		.hero__divider {
			margin-inline: auto;
		}

		.hero__right-shape {
			width: 280px;
			height: 280px;
			border-radius: 40px 40px 0 0;
			background: var(--emerald);
		}

		.hero__right-photo {
			position: relative;
			z-index: 2;
			left: auto;
			bottom: auto;
			transform: none;
			width: 100%;
			max-width: 360px;
			height: auto;
			max-height: none;
			object-fit: contain;
			object-position: bottom center;
			border-radius: 12px;
		}

		.hero__name {
			font-size: 64px;
			line-height: 1.05;
		}
	}

	@media (max-width: 1200px) and (max-height: 820px) {
		.hero {
			padding-top: 5.25rem;
			padding-bottom: 2rem;
		}
	}

	@media (max-width: 768px) {
		.hero {
			padding: 5rem 1rem 3rem;
		}

		.hero__left {
			gap: 1rem;
		}

		.hero__name {
			font-size: 36px;
			line-height: 1.05;
		}

		.hero__intro {
			max-width: 280px;
		}

		.hero__right-shape {
			width: 325px;
			height: 255px;
			border-radius: 36px 36px 0 0;
		}

		.lesen-section {
			padding: 3.5rem 0;
		}

		.lesen-section-inner {
			padding: 0 1rem;
		}

		.vergleich-inner {
			padding: 0 1rem;
		}

		.wusstest-inner {
			padding: 0 1rem;
		}

		.lesen-cta-inner {
			padding: 0 1rem;
		}

		.benefit-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.lesen-wusstest {
			padding: 3rem 0;
		}

		.wusstest-text {
			font-size: 16px;
		}

		.wusstest-text strong {
			font-size: 18px;
		}

		.lesen-cta {
			padding: 3.5rem 0 4rem;
		}
	}

	/* Drop 100vh hero on viewports that use the 2-column layout */
	@media (min-width: 769px) {
		.hero {
			min-height: auto;
		}
	}

	/* Wide desktop only: breathing room under 2-col hero (not on stacked tablet) */
	@media (min-width: 1201px) {
		.hero {
			padding-bottom: 8.5rem;
		}
	}
</style>
