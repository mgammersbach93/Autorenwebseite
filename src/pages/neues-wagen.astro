---
import Layout from '../layouts/Layout.astro';

const characterImages = {
	malte: '/images/gluecklich-sein-malte.png',
	lea: '/images/gluecklich-sein-lea.png',
	elias: '/images/gluecklich-sein-elias.png',
	sofia: '/images/gluecklich-sein-sofia.png',
};

const characters = [
	{
		id: 'malte',
		name: 'Malte',
		role: 'Leitet den Workshop',
		description:
			'Malte liebt es, andere dabei zu unterstützen, glücklich und unbeschwerter zu werden. Aufgrund seiner Depression gelingt ihm das allerdings im eigenen Alltag immer seltener.',
	},
	{
		id: 'lea',
		name: 'Lea',
		role: 'Sucht die große Liebe',
		description:
			'Lea möchte vor ihrem 30. Geburtstag unbedingt einen Partner finden. Bis jetzt stolpert sie von einem Online-Date ins nächste und verliert dabei so langsam ihren Optimismus.',
	},
	{
		id: 'elias',
		name: 'Elias',
		role: 'Sucht einen erfüllenden Job',
		description:
			'Elias will endlich wieder Spaß am Arbeiten haben, weiß aber nicht, wonach er suchen soll. Aus Angst vor Veränderung verharrt er seit Jahren in seinem ungeliebten Bürojob.',
	},
	{
		id: 'sofia',
		name: 'Sofia',
		role: 'Liebt die Karriere',
		description:
			'Sofia ist die jüngste Senior Sales Managerin bei einem führenden eCommerce-Anbieter. Dafür hat sie in den vergangenen Jahren hart gearbeitet – und auf vieles verzichtet.',
	},
];
---

<Layout title="Sie wollten endlich Neues wagen">
	<!-- 1. HERO (Off-White) -->
	<section class="g-hero">
		<div class="g-hero-inner">
			<div class="g-hero-cover-wrap">
				<img
					src="/images/sie-wollten-endlich-neues-wagen.jpg"
					alt="Buchcover: Sie wollten endlich Neues wagen"
					class="g-hero-cover"
				/>
			</div>
			<div class="g-hero-content">
				<h1 class="g-eyebrow">SIE WOLLTEN ENDLICH NEUES WAGEN</h1>
				<p class="g-hero-title">Eine Geschichte über Millennials im Aufbruch</p>
				<a href="#" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Jetzt bestellen</a>
			</div>
		</div>
	</section>

	<!-- 2. KLAPPENTEXT (Off-White) -->
	<section class="g-klappentext">
		<div class="g-klappentext-inner">
			<h2>Manchmal braucht es Mut</h2>
			<p class="g-body">
				Elias sehnt sich nach einem erfüllenden Job, Lea möchte vor ihrem 30. Geburtstag unbedingt einen Partner finden, Malte belasten seine Depressionen in der Ehe und Sofia steht kurz vor der nächsten Beförderung.
			</p>
			<p class="g-body">
				In einem Workshop für Millennials lernen sich die vier kennen. Gemeinsam sprechen sie über Herausforderungen ihrer Generation und den Umgang mit persönlichen Sinnkrisen.
			</p>
			<p class="g-body">
				Der Kurs wird urplötzlich zur Nebensache, als das Rheinland im Hochwasser versinkt. Eine ganze Region steht unter Schock. Die Aufräumarbeiten in den betroffenen Gebieten entwickeln sich zu einer emotionalen Reise, die das Leben von Elias, Lea, Malte und Sofia für immer verändern wird.
			</p>
		</div>
	</section>

	<!-- 3. WORKSHOP (Emerald, full-width) -->
	<section class="g-workshop full-bleed">
		<div class="g-workshop-inner">
			<h2>Der Millennial Workshop</h2>
			<p class="g-workshop-subtitle">Klicke auf eine Person, um mehr zu erfahren</p>
			<div class="g-characters">
				{characters.map((c) => (
					<button
						type="button"
						class="g-char-card"
						data-char={c.id}
						aria-pressed={c.id === 'malte'}
						aria-label={`${c.name} – ${c.role}`}
					>
						<div class="g-char-card-visual">
							<div class="g-char-card-center">
								<div class="g-char-card-bg" aria-hidden="true"></div>
								<img
									src={characterImages[c.id]}
									alt={c.name}
									class="g-char-card-img"
								/>
							</div>
						</div>
						<span class="g-char-name">{c.name}</span>
					</button>
				))}
			</div>
			<div class="g-char-info">
				<span class="g-eyebrow g-char-role-label">Leitet den Workshop</span>
				<p class="g-char-desc">
					Malte liebt es, andere dabei zu unterstützen, glücklich und unbeschwerter zu werden. Aufgrund seiner Depression gelingt ihm das allerdings im eigenen Alltag immer seltener.
				</p>
			</div>
		</div>
	</section>

	<!-- 4. VIDEO (Off-White) -->
	<section class="g-video">
		<div class="g-video-inner">
			<h2>Buchtrailer</h2>
			<div class="g-video-placeholder" aria-hidden="true">
				<span class="g-play-icon" aria-hidden="true">▶</span>
			</div>
		</div>
	</section>

	<!-- 5. NETFLIX (Off-White) -->
	<section class="g-netflix">
		<div class="g-netflix-inner">
			<h2>Wie Netflix – nur als Buch</h2>
			<div class="g-netflix-grid">
				<div class="g-netflix-col">
					<h3 class="g-netflix-title">Kurze Kapitel</h3>
					<p class="g-netflix-text">Schneller Einstieg und einfaches Lesen für geübte und ungeübte Leser*innen</p>
				</div>
				<div class="g-netflix-col">
					<h3 class="g-netflix-title">Vier Perspektiven</h3>
					<p class="g-netflix-text">Handlung, Gefühle und Emotionen der vier Hauptfiguren hautnah miterleben</p>
				</div>
				<div class="g-netflix-col">
					<h3 class="g-netflix-title">Abwechslung</h3>
					<p class="g-netflix-text">Perspektivwechsel garantiert Spannung und packende Unterhaltung</p>
				</div>
			</div>
		</div>
	</section>

	<!-- 6. CTA (Off-White) -->
	<section class="g-cta">
		<div class="g-cta-inner">
			<div class="g-cta-cover-wrap">
				<img
					src="/images/sie-wollten-endlich-neues-wagen.png"
					alt="Buchcover: Sie wollten endlich Neues wagen"
					class="g-cta-cover"
				/>
			</div>
			<a href="#" class="btn btn-primary g-cta-btn" target="_blank" rel="noopener noreferrer">Jetzt bestellen</a>
		</div>
	</section>
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const container = document.querySelector('.g-characters');
		const workshop = document.querySelector('.g-workshop');
		const roleLabel = workshop?.querySelector('.g-char-role-label') ?? document.querySelector('.g-char-role-label');
		const descEl = workshop?.querySelector('.g-char-desc') ?? document.querySelector('.g-char-desc');

		if (!container) return;

		let cards = Array.from(container.querySelectorAll('.g-char-card'));
		const isMobile = window.matchMedia('(max-width: 1024px)').matches;
		let setWidth = null;
		let setStart = null;

		const data = {
			malte: {
				role: 'Leitet den Workshop',
				description:
					'Malte liebt es, andere dabei zu unterstützen, glücklich und unbeschwerter zu werden. Aufgrund seiner Depression gelingt ihm das allerdings im eigenen Alltag immer seltener.',
			},
			lea: {
				role: 'Sucht die große Liebe',
				description:
					'Lea möchte vor ihrem 30. Geburtstag unbedingt einen Partner finden. Bis jetzt stolpert sie von einem Online-Date ins nächste und verliert dabei so langsam ihren Optimismus.',
			},
			elias: {
				role: 'Sucht einen erfüllenden Job',
				description:
					'Elias will endlich wieder Spaß am Arbeiten haben, weiß aber nicht, wonach er suchen soll. Aus Angst vor Veränderung verharrt er seit Jahren in seinem ungeliebten Bürojob.',
			},
			sofia: {
				role: 'Liebt die Karriere',
				description:
					'Sofia ist die jüngste Senior Sales Managerin bei einem führenden eCommerce-Anbieter. Dafür hat sie in den vergangenen Jahren hart gearbeitet – und auf vieles verzichtet.',
			},
		};

		function selectChar(id) {
			const allCards = Array.from(container.querySelectorAll('.g-char-card'));
			allCards.forEach((btn) => {
				const isSelected = btn.dataset.char === id;
				btn.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
				btn.classList.toggle('is-active', isSelected);
				btn.classList.toggle('is-centered', isSelected);
			});
			const charData = data[id];
			if (charData) {
				if (roleLabel) roleLabel.textContent = charData.role;
				if (descEl) descEl.textContent = charData.description;
			}
		}

		function centerCard(card, behavior = 'smooth') {
			const containerWidth = container.offsetWidth;
			const cardLeft = card.offsetLeft;
			const cardWidth = card.offsetWidth;
			const scrollLeft = cardLeft - containerWidth / 2 + cardWidth / 2;
			if (behavior === 'smooth') {
				container.scrollTo({ left: scrollLeft, behavior: 'smooth' });
			} else {
				container.scrollLeft = scrollLeft;
			}
		}

		function updateCenteredCard() {
			if (window.innerWidth > 1024) return;
			const allCards = Array.from(container.querySelectorAll('.g-char-card'));
			const containerRect = container.getBoundingClientRect();
			const containerCenter = containerRect.left + containerRect.width / 2;

			let closestCard = null;
			let closestDistance = Infinity;

			allCards.forEach((card) => {
				const cardRect = card.getBoundingClientRect();
				const cardCenter = cardRect.left + cardRect.width / 2;
				const distance = Math.abs(containerCenter - cardCenter);

				if (distance < closestDistance) {
					closestDistance = distance;
					closestCard = card;
				}
			});

			if (closestCard) {
				const id = closestCard.dataset.char;
				if (id) {
					selectChar(id);
					requestAnimationFrame(() => centerCard(closestCard, 'auto'));
				}
			}
		}

		let ignoreScrollUntil = 0;
		function updateCenteredCardWithGuard() {
			if (Date.now() < ignoreScrollUntil) return;
			updateCenteredCard();
		}

		// Mobile only: clone cards for infinite loop
		if (isMobile) {
			const clonesBefore = cards.map((card) => card.cloneNode(true));
			const clonesAfter = cards.map((card) => card.cloneNode(true));

			clonesBefore.reverse().forEach((clone) => {
				clone.setAttribute('data-clone', 'true');
				container.insertBefore(clone, container.firstChild);
			});

			clonesAfter.forEach((clone) => {
				clone.setAttribute('data-clone', 'true');
				container.appendChild(clone);
			});

			cards = Array.from(container.querySelectorAll('.g-char-card'));
			requestAnimationFrame(() => {
				requestAnimationFrame(() => {
					if (cards.length >= 9) {
						setStart = cards[4].offsetLeft;
						setWidth = cards[8].offsetLeft - cards[4].offsetLeft;
						container.style.scrollBehavior = 'auto';
						container.scrollLeft = setStart;
						container.style.scrollBehavior = '';
						const middleMalte = cards[4];
						if (middleMalte) centerCard(middleMalte, 'auto');
					}
				});
			});
		}

		// Scroll: infinite loop jump (mobile only) then update centered card
		container.addEventListener('scroll', () => {
			const hasClones = container.querySelectorAll('[data-clone="true"]').length > 0;
			if (hasClones && setWidth != null && setStart != null) {
				container.style.scrollBehavior = 'auto';
				if (container.scrollLeft >= setStart + setWidth) {
					container.scrollLeft = container.scrollLeft - setWidth;
				}
				if (container.scrollLeft < setStart) {
					container.scrollLeft = container.scrollLeft + setWidth;
				}
				container.style.scrollBehavior = '';
			}
			window.requestAnimationFrame(updateCenteredCardWithGuard);
		});

		// Click: delegation (works for original and clone cards)
		container.addEventListener('click', (e) => {
			const card = e.target.closest('.g-char-card');
			if (!card) return;
			const id = card.getAttribute('data-char') || card.dataset.char;
			if (!id) return;
			ignoreScrollUntil = Date.now() + 400;
			selectChar(id);
			if (window.innerWidth <= 1024) {
				centerCard(card, 'smooth');
			}
		});

		// Initial selection; mobile centering is done in rAF after cloning
		selectChar('malte');

		// Resize: remove clones when switching to desktop
		window.addEventListener('resize', () => {
			const isNowMobile = window.matchMedia('(max-width: 1024px)').matches;
			if (!isNowMobile) {
				container.querySelectorAll('[data-clone="true"]').forEach((clone) => clone.remove());
				cards = Array.from(container.querySelectorAll('.g-char-card'));
			}
		});
	});
</script>

<style>
	/* Page-specific color overrides for "Neues Wagen" */
	.g-hero .g-eyebrow {
		color: #FBA922;
	}

	.g-char-info .g-eyebrow {
		color: #C13A00;
	}

	.g-netflix h3 {
		color: #FBA922;
	}

	.btn-primary {
		background-color: #C13A00;
	}

	.btn-primary:hover {
		background-color: #a32f00;
	}

	.g-char-card-bg {
		background: #FBA922;
	}

	.g-video-placeholder {
		background-color: #FBA922;
	}

	/* Shared */
	.g-eyebrow {
		display: block;
		font-family: 'Manrope', sans-serif;
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.28em;
		color: #FBA922;
		margin: 0 0 0.75rem 0;
	}

	/* Section H2s – default heading style (no eyebrow) */
	.g-klappentext-inner h2,
	.g-workshop-inner h2,
	.g-video-inner h2,
	.g-netflix-inner h2 {
		font-family: 'Manrope', sans-serif;
		font-size: 28px;
		font-weight: 700;
		line-height: 1.1;
		color: var(--text);
		text-transform: none;
		text-align: center;
		margin: 0 0 1rem 0;
	}

	.g-video-inner h2 {
		margin-bottom: 1.5rem;
	}

	.g-netflix-inner h2 {
		margin-bottom: 2.5rem;
	}

	.g-workshop-inner h2 {
		margin-bottom: 1rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: auto;
		padding: 0.85rem 2rem;
		font-family: 'Manrope', sans-serif;
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		border-radius: 9999px;
		cursor: pointer;
		transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
		text-decoration: none;
		white-space: nowrap;
		box-sizing: border-box;
		border: none;
	}

	.btn-primary {
		background-color: #C13A00;
		color: var(--bg);
	}

	.btn-primary:hover {
		background-color: #a32f00;
	}

	/* 1. HERO */
	.g-hero {
		background-color: var(--bg);
		padding: 5rem 0;
	}

	.g-hero-inner {
		max-width: 1100px;
		margin-inline: auto;
		display: grid;
		grid-template-columns: 1fr 1.2fr;
		gap: 3rem;
		align-items: center;
	}

	.g-hero-cover-wrap {
		max-width: 360px;
		overflow: hidden;
	}

	.g-hero-cover {
		width: 100%;
		max-width: 360px;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		display: block;
	}

	.g-hero-content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.g-hero-title {
		font-family: 'Manrope', sans-serif;
		font-size: 42px;
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: var(--text);
		margin: 0 0 2.5rem;
	}

	@media (max-width: 1024px) {
		.g-hero .g-eyebrow {
			margin-bottom: 1.5rem;
		}
		.g-hero-inner {
			grid-template-columns: 1fr;
			text-align: center;
			align-items: center;
		}
		.g-hero-cover-wrap {
			max-width: 220px;
			margin-inline: auto;
		}
		.g-hero-content {
			align-items: center;
		}
	}

	/* 2. KLAPPENTEXT */
	.g-klappentext {
		background-color: var(--bg);
		padding: 2rem 0 5rem;
	}

	.g-klappentext-inner {
		max-width: 680px;
		margin-inline: auto;
	}

	.g-body {
		font-family: 'Manrope', sans-serif;
		font-size: 16px;
		font-weight: 300;
		line-height: 1.85;
		color: var(--text);
		margin: 0 0 1.25rem;
	}

	.g-body:last-of-type {
		margin-bottom: 0;
	}

	/* 3. WORKSHOP – off-white section; only character shapes + info box are emerald */
	.g-workshop.full-bleed {
		width: 100vw;
		margin-left: calc(50% - 50vw);
		box-sizing: border-box;
		background-color: var(--bg);
		color: var(--text);
		padding: 2rem var(--page-padding-desktop) 5rem;
	}

	.g-workshop-inner {
		max-width: 1000px;
		margin-inline: auto;
	}

	.g-workshop-subtitle {
		font-family: 'Manrope', sans-serif;
		font-size: 16px;
		font-weight: 300;
		line-height: 1.85;
		color: var(--text);
		text-align: center;
		margin: 0 0 1.5rem 0;
	}

	.g-characters {
		display: grid;
		grid-template-columns: repeat(4, 260px);
		gap: 2.5rem;
		justify-content: center;
		margin: 0 0 2rem 0;
		padding-top: 0;
		overflow: visible;
	}

	.g-char-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		width: 260px;
		min-width: 0;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0;
		opacity: 0.5;
		transition: opacity 0.3s ease;
		position: relative;
		overflow: visible;
	}

	.g-char-card.is-active,
	.g-char-card[aria-pressed='true'] {
		opacity: 1;
	}

	.g-char-card-visual {
		display: flex;
		justify-content: center;
		align-items: flex-end;
		width: 260px;
		height: 260px;
		overflow: visible;
	}

	.g-char-card-center {
		position: relative;
		width: 260px;
		height: 260px;
		flex-shrink: 0;
	}

	.g-char-card-bg {
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 200px;
		background: #FBA922;
		border-radius: 40px 40px 0 0;
		z-index: 0;
	}

	.g-char-card-img {
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 260px;
		object-fit: contain;
		object-position: center bottom;
		display: block;
		z-index: 1;
	}

	.g-char-name {
		font-family: 'Manrope', sans-serif;
		font-size: 14px;
		font-weight: 600;
		color: var(--text);
	}

	.g-char-info {
		background-color: var(--bg);
		padding: 2rem;
		min-height: 140px;
		box-sizing: border-box;
	}

	.g-char-info .g-eyebrow {
		margin-bottom: 0.5rem;
		color: #C13A00;
	}

	.g-char-desc {
		font-family: 'Manrope', sans-serif;
		font-size: 16px;
		font-weight: 300;
		line-height: 1.7;
		color: var(--text);
		margin: 0;
	}

	@media (max-width: 1024px) {
		.g-workshop-inner {
			overflow-x: visible;
		}

		.g-char-info {
			padding: 0 2rem 2rem 2rem;
		}

		.g-characters {
			display: flex;
			align-items: flex-end;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			scroll-behavior: smooth;
			-webkit-overflow-scrolling: touch;
			gap: 1rem;
			scrollbar-width: none;
			justify-content: flex-start;
			margin: -10rem 0 1rem 0;
			padding-top: 1.5rem;
			padding-bottom: 1rem;
			padding-left: calc(50vw - 190px);
			padding-right: calc(50vw - 190px);
			scroll-padding: 0 calc(50vw - 190px);
			width: 100vw;
			margin-left: calc(50% - 50vw);
			box-sizing: border-box;
		}

		.g-characters::-webkit-scrollbar {
			display: none;
		}

		.g-char-card {
			display: flex;
			flex-direction: column;
			align-items: center;
			flex: 0 0 260px;
			width: 260px;
			scroll-snap-align: center;
			opacity: 0.5;
			transition: opacity 0.3s ease, flex 0.35s ease, width 0.35s ease;
			margin: 0;
			overflow: visible;
		}

		.g-char-card.is-centered,
		.g-char-card.is-active,
		.g-char-card[aria-pressed='true'] {
			opacity: 1;
			z-index: 10;
			flex: 0 0 380px;
			width: 380px;
		}

		.g-char-card-visual {
			width: 260px;
			height: 364px;
			overflow: visible;
			transition: width 0.35s ease, height 0.35s ease;
			flex-shrink: 0;
		}

		.g-char-card.is-centered .g-char-card-visual,
		.g-char-card.is-active .g-char-card-visual,
		.g-char-card[aria-pressed='true'] .g-char-card-visual {
			width: 380px;
			height: 532px;
		}

		.g-char-card-center {
			width: 260px;
			height: 364px;
			overflow: visible;
			transition: width 0.35s ease, height 0.35s ease;
		}

		.g-char-card.is-centered .g-char-card-center,
		.g-char-card.is-active .g-char-card-center,
		.g-char-card[aria-pressed='true'] .g-char-card-center {
			width: 380px;
			height: 532px;
		}

		.g-char-card-bg {
			height: 182px;
			transition: height 0.35s ease;
