---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ogImageSrc from '../images/Feature_neues-wagen.png';
import heroBookCover from '../images/sie-wollten-endlich-neues-wagen.jpg';
import ctaBookMockup from '../images/sie-wollten-endlich-neues-wagen.png';
import charMalte from '../images/gluecklich-sein-malte.png';
import charLea from '../images/gluecklich-sein-lea.png';
import charElias from '../images/gluecklich-sein-elias.png';
import charSofia from '../images/gluecklich-sein-sofia.png';
import crossCover from '../images/sie-wollten-doch-nur-gluecklich-sein.jpg';

/** YouTube-Video-ID aus der Embed-URL (z. B. youtube.com/watch?v=…) – vor Livegang eintragen */
const youtubeVideoId = 'R31V32UzdsM';

const siteOrigin = Astro.site?.origin ?? 'https://mgammersbach.de';
const neuesWagenOg = await getImage({ src: ogImageSrc, width: 1200 });
const ogImageUrl = new URL(neuesWagenOg.src, siteOrigin).href;

const characterImages: Record<string, ImageMetadata> = {
	malte: charMalte,
	lea: charLea,
	elias: charElias,
	sofia: charSofia,
};

const characters = [
	{
		id: 'malte',
		name: 'Malte',
		role: 'Leitet den Workshop',
		description:
			'Malte hilft anderen liebend gern dabei, glücklich und unbeschwert zu werden. In seinem eigenen Alltag fällt ihm das aufgrund seiner Depression allerdings zunehmend schwerer.',
	},
	{
		id: 'lea',
		name: 'Lea',
		role: 'Sucht die große Liebe',
		description:
			'Lea möchte vor ihrem 30. Geburtstag unbedingt einen Partner finden. Bis jetzt stolpert sie von einem Online-Date ins nächste und verliert dabei so langsam ihren Optimismus.',
	},
	{
		id: 'elias',
		name: 'Elias',
		role: 'Sucht einen erfüllenden Job',
		description:
			'Elias will endlich wieder Spaß am Arbeiten haben, weiß aber nicht, wonach er suchen soll. Aus Angst vor Veränderung verharrt er seit Jahren in seinem ungeliebten Bürojob.',
	},
	{
		id: 'sofia',
		name: 'Sofia',
		role: 'Liebt die Karriere',
		description:
			'Sofia ist die jüngste Senior Sales Managerin bei einem führenden eCommerce-Anbieter. Dafür hat sie in den vergangenen Jahren hart gearbeitet – und auf vieles verzichtet.',
	},
];
---

<Layout
	title="Sie wollten endlich Neues wagen | Roman"
	description="Eine inspirierende Geschichte über Millennials im Aufbruch nach einem Hochwasser, das alles verändert hat."
	image={ogImageUrl}
>
	<!-- 1. HERO (Off-White) -->
	<section class="g-hero">
		<div class="g-hero-inner">
			<div class="g-hero-cover-wrap">
				<Image
					src={heroBookCover}
					alt="Buchcover: Sie wollten endlich Neues wagen"
					class="g-hero-cover"
					width={900}
				/>
			</div>
			<div class="g-hero-content">
				<h1 class="g-eyebrow">SIE WOLLTEN ENDLICH NEUES WAGEN</h1>
				<p class="g-hero-title">Eine Geschichte über Millennials im Aufbruch</p>
				<a href="#" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Bald verfügbar</a>
			</div>
		</div>
	</section>

	<!-- 2. KLAPPENTEXT (Off-White) -->
	<section class="g-klappentext">
		<div class="g-klappentext-inner">
			<p class="g-body">
				Nach dem verheerenden Hochwasser in Erftstadt machen die Aufräumarbeiten große Fortschritte. Doch Ruhe kehrt noch lange nicht ein.
			</p>
			<p class="g-body">
				Elias bekommt nach einem viralen Video seine eigene Reportage im WDR und träumt von der Karriere als Musiker. Lea hat auf einmal zwei Männer im Rennen, die sie zur Hochzeit ihrer Schwester begleiten könnten. Malte sieht sich und seine Frau durch die Finanzierung fürs Haus mit einem Berg voll Schulden konfrontiert und Sofia fragt sich nach ihrem Zusammenbruch, ob eine weitere Beförderung wirklich der richtige Schritt ist.
			</p>
			<p class="g-body">
				Während die vier im »Millennial Workshop« weiter hilfreiche Impulse für ihren Alltag sammeln, erteilt ihnen das Leben selbst die wichtigste Lektion: Manchmal muss man Neues wagen, um endlich glücklich zu sein.
			</p>
		</div>
	</section>

	<!-- 3. VIDEO (Off-White) -->
	<section class="g-video">
		<div class="g-video-inner">
			<div class="youtube-consent-wrapper">
				<iframe
					data-category="media"
					data-service="youtube"
					data-src={`https://www.youtube-nocookie.com/embed/${youtubeVideoId}`}
					data-autoscale
					frameborder="0"
					allowfullscreen></iframe>
				<div class="youtube-placeholder" data-placeholder data-category="media" data-service="youtube">
					<div class="youtube-placeholder__inner">
						<svg
							width="40"
							height="40"
							viewBox="0 0 24 24"
							fill="none"
							stroke="#B89A3E"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect>
							<line x1="7" y1="2" x2="7" y2="22"></line>
							<line x1="17" y1="2" x2="17" y2="22"></line>
							<line x1="2" y1="12" x2="22" y2="12"></line>
							<line x1="2" y1="7" x2="7" y2="7"></line>
							<line x1="2" y1="17" x2="7" y2="17"></line>
							<line x1="17" y1="17" x2="22" y2="17"></line>
							<line x1="17" y1="7" x2="22" y2="7"></line>
						</svg>
						<p class="youtube-placeholder__text">
							Dieses Video wird von YouTube bereitgestellt. Mit dem Laden werden Daten an YouTube übertragen.
						</p>
						<button
							type="button"
							class="youtube-placeholder__btn"
							onclick="CookieConsent.showPreferences()">Cookie-Einstellungen öffnen</button>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- 4. WORKSHOP (Emerald, full-width) -->
	<section class="g-workshop full-bleed">
		<div class="g-workshop-inner">
			<h2>Der Millennial Workshop</h2>
			<p class="g-workshop-subtitle">Klicke auf eine Person, um mehr zu erfahren</p>

			<div class="g-mobile-slider">
				<div class="g-mobile-slider-track">
					{characters.map((c, index) => (
						<div
							class:list={['g-mobile-card', { 'is-active': index === 0 }]}
							data-char={c.id}
							data-index={index}
						>
							<div class="g-mobile-card-visual">
								<div class="g-mobile-card-bg" aria-hidden="true"></div>
								<Image src={characterImages[c.id]} alt={c.name} class="g-mobile-card-img" width={400} />
							</div>
							<span class="g-mobile-card-name">{c.name}</span>
						</div>
					))}
				</div>
				<div class="g-mobile-nav">
					<button type="button" class="g-mobile-nav-btn g-mobile-prev" aria-label="Vorherige Person">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M15 18l-6-6 6-6"></path>
						</svg>
					</button>
					<div class="g-mobile-dots">
						{characters.map((c, index) => (
							<div
								class:list={['g-mobile-dot', { 'is-active': index === 0 }]}
								data-index={index}
							>
							</div>
						))}
					</div>
					<button type="button" class="g-mobile-nav-btn g-mobile-next" aria-label="Nächste Person">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M9 18l6-6-6-6"></path>
						</svg>
					</button>
				</div>
			</div>

			<div class="g-char-info">
				<span class="g-eyebrow g-char-role-label">Leitet den Workshop</span>
				<p class="g-char-desc">
					Malte hilft anderen liebend gern dabei, glücklich und unbeschwert zu werden. In seinem eigenen Alltag fällt ihm das aufgrund seiner Depression allerdings zunehmend schwerer.
				</p>
			</div>
		</div>
	</section>

	<!-- 5. Buchmockup -->
	<section class="g-cta g-cta--book">
		<div class="g-cta-inner">
			<div class="g-cta-cover-wrap">
				<Image
					src={ctaBookMockup}
					alt="Buchcover: Sie wollten endlich Neues wagen"
					class="g-cta-cover"
					width={900}
				/>
			</div>
		</div>
	</section>

	<!-- 6. NETFLIX (Off-White) -->
	<section class="g-netflix">
		<div class="g-netflix-inner">
			<h2>Wie Netflix – nur als Buch</h2>
			<div class="g-netflix-grid">
				<div class="g-netflix-col">
					<h3 class="g-netflix-title">Kurze Kapitel</h3>
					<p class="g-netflix-text">Schneller Einstieg und einfaches Lesen für geübte und ungeübte Leser*innen</p>
				</div>
				<div class="g-netflix-col">
					<h3 class="g-netflix-title">Vier Perspektiven</h3>
					<p class="g-netflix-text">Handlung, Gefühle und Emotionen der vier Hauptfiguren hautnah miterleben</p>
				</div>
				<div class="g-netflix-col">
					<h3 class="g-netflix-title">Abwechslung</h3>
					<p class="g-netflix-text">Perspektivwechsel garantiert Spannung und packende Unterhaltung</p>
				</div>
			</div>
		</div>
	</section>

	<!-- 7. Jetzt bestellen -->
	<section class="g-cta g-cta--order">
		<div class="g-cta-inner">
			<a href="#" class="btn btn-primary g-cta-btn" target="_blank" rel="noopener noreferrer">Bald verfügbar</a>
		</div>
	</section>

	<!-- 8. Cross-CTA: Zu Teil 1 -->
	<section class="g-cross-cta">
		<div class="g-cross-cta-inner">
			<Image
				src={crossCover}
				alt="Buchcover: Sie wollten doch nur glücklich sein"
				class="g-cross-cta-cover"
				width={280}
				height={420}
			/>
			<div class="g-cross-cta-text">
				<span class="g-eyebrow">So fing alles an</span>
				<h2>Sie wollten doch nur glücklich sein</h2>
				<p class="g-char-desc g-cross-cta-sub">Erfahre, wie sich Elias, Lea, Malte und Sofia kennengelernt haben.</p>
				<a href="/gluecklich-sein/" class="btn g-cross-cta-btn">Zu Teil 1</a>
			</div>
		</div>
	</section>
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const workshop = document.querySelector('.g-workshop');
		const roleLabel = workshop?.querySelector('.g-char-role-label') ?? document.querySelector('.g-char-role-label');
		const descEl = workshop?.querySelector('.g-char-desc') ?? document.querySelector('.g-char-desc');

		const data = {
			malte: {
				role: 'Leitet den Workshop',
				description:
					'Malte hilft anderen liebend gern dabei, glücklich und unbeschwert zu werden. In seinem eigenen Alltag fällt ihm das aufgrund seiner Depression allerdings zunehmend schwerer.',
			},
			lea: {
				role: 'Sucht die große Liebe',
				description:
					'Lea möchte vor ihrem 30. Geburtstag unbedingt einen Partner finden. Bis jetzt stolpert sie von einem Online-Date ins nächste und verliert dabei so langsam ihren Optimismus.',
			},
			elias: {
				role: 'Sucht einen erfüllenden Job',
				description:
					'Elias will endlich wieder Spaß am Arbeiten haben, weiß aber nicht, wonach er suchen soll. Aus Angst vor Veränderung verharrt er seit Jahren in seinem ungeliebten Bürojob.',
			},
			sofia: {
				role: 'Liebt die Karriere',
				description:
					'Sofia ist die jüngste Senior Sales Managerin bei einem führenden eCommerce-Anbieter. Dafür hat sie in den vergangenen Jahren hart gearbeitet – und auf vieles verzichtet.',
			},
		};

		const mobileSlider = document.querySelector('.g-mobile-slider');
		if (!mobileSlider) return;

		function bindCharacterSlider() {
			if (mobileSlider.dataset.gMobileBound === '1') return;
			mobileSlider.dataset.gMobileBound = '1';

			const mobileCards = Array.from(mobileSlider.querySelectorAll('.g-mobile-card'));
			const mobileDots = Array.from(mobileSlider.querySelectorAll('.g-mobile-dot'));
			const prevM = mobileSlider.querySelector('.g-mobile-prev');
			const nextM = mobileSlider.querySelector('.g-mobile-next');

			let currentIndex = 0;
			const totalCards = mobileCards.length;

			function setMobileActive(index) {
				currentIndex = (index + totalCards) % totalCards;

				const prevIdx = (currentIndex - 1 + totalCards) % totalCards;
				const nextIdx = (currentIndex + 1) % totalCards;

				mobileCards.forEach((card) => {
					card.classList.remove('is-active');
					card.style.display = 'none';
				});

				const prevCard = mobileCards[prevIdx];
				const currentCard = mobileCards[currentIndex];
				const nextCard = mobileCards[nextIdx];

				prevCard.style.display = 'flex';
				prevCard.style.order = '1';

				currentCard.style.display = 'flex';
				currentCard.style.order = '2';
				currentCard.classList.add('is-active');

				nextCard.style.display = 'flex';
				nextCard.style.order = '3';

				mobileDots.forEach((dot, i) => {
					dot.classList.toggle('is-active', i === currentIndex);
				});

				const id = currentCard.dataset.char;
				if (id && data[id]) {
					if (roleLabel) roleLabel.textContent = data[id].role;
					if (descEl) descEl.textContent = data[id].description;
				}
			}

			prevM?.addEventListener('click', () => setMobileActive(currentIndex - 1));
			nextM?.addEventListener('click', () => setMobileActive(currentIndex + 1));

			mobileCards.forEach((card, idx) => {
				card.addEventListener('click', () => {
					if (!card.classList.contains('is-active')) {
						setMobileActive(idx);
					}
				});
			});

			let touchStartX = 0;
			const track = mobileSlider.querySelector('.g-mobile-slider-track');

			track?.addEventListener(
				'touchstart',
				(e) => {
					touchStartX = e.touches[0].clientX;
				},
				{ passive: true }
			);

			track?.addEventListener(
				'touchend',
				(e) => {
					const touchEndX = e.changedTouches[0].clientX;
					const diff = touchStartX - touchEndX;

					if (Math.abs(diff) > 50) {
						if (diff > 0) {
							setMobileActive(currentIndex + 1);
						} else {
							setMobileActive(currentIndex - 1);
						}
					}
				},
				{ passive: true }
			);

			setMobileActive(0);
		}

		bindCharacterSlider();
	});
</script>

<style>
	/* Neues Wagen – orange palette (#FBA922 / #C13A00) */
	.g-hero .g-eyebrow {
		color: #FBA922;
	}

	/* Shared */
	.g-eyebrow {
		display: block;
		font-family: 'Manrope', sans-serif;
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.28em;
		color: #C13A00;
		margin: 0 0 0.75rem 0;
	}

	/* Section H2s – default heading style (no eyebrow) */
	.g-workshop-inner h2,
	.g-netflix-inner h2,
	.g-cross-cta-text h2 {
		font-family: 'Manrope', sans-serif;
		font-size: 28px;
		font-weight: 700;
		line-height: 1.1;
		color: var(--text);
		text-transform: none;
		text-align: center;
		margin: 0 0 1rem 0;
	}

	.g-netflix-inner h2 {
		margin-bottom: 2.5rem;
	}

	.g-workshop-inner h2 {
		margin-bottom: 1rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: auto;
		padding: 0.85rem 2rem;
		font-family: 'Manrope', sans-serif;
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		border-radius: 9999px;
		cursor: pointer;
		transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
		text-decoration: none;
		white-space: nowrap;
		box-sizing: border-box;
		border: none;
	}

	.btn-primary {
		background-color: #C13A00;
		color: var(--bg);
	}

	.btn-primary:hover {
		background-color: #a83200;
	}

	/* 1. HERO */
	.g-hero {
		background-color: var(--bg);
		padding: 5rem 0;
	}

	.g-hero-inner {
		max-width: 1100px;
		margin-inline: auto;
		display: grid;
		grid-template-columns: 1fr 1.2fr;
		gap: 3rem;
		align-items: center;
	}

	.g-hero-cover-wrap {
		max-width: 360px;
		overflow: hidden;
	}

	.g-hero-cover-wrap picture {
		display: block;
		width: 100%;
		max-width: 360px;
	}

	.g-hero-cover {
		width: 100%;
		height: auto;
		display: block;
	}

	.g-hero-content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.g-hero-title {
		font-family: 'Manrope', sans-serif;
		font-size: 42px;
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: var(--text);
		margin: 0 0 2.5rem;
	}

	@media (max-width: 1024px) {
		.g-hero .g-eyebrow {
			margin-bottom: 1.5rem;
		}
		.g-hero-inner {
			grid-template-columns: 1fr;
			text-align: center;
			align-items: center;
		}
		.g-hero-cover-wrap {
			max-width: 200px;
			margin-inline: auto;
		}
		.g-hero-content {
			align-items: center;
		}
	}

	@media (max-width: 768px) {
		.g-hero {
			padding: 5.5rem 0 3rem;
		}

		.g-hero-cover-wrap {
			max-width: 160px;
			overflow: visible;
		}

		.g-hero-cover-wrap picture {
			max-width: 160px;
		}

		.g-hero-title {
			font-size: 32px;
			margin-bottom: 1.5rem;
		}

		.g-hero .g-eyebrow {
			margin-bottom: 1rem;
			font-size: 10px;
		}
	}

	/* 2. KLAPPENTEXT */
	.g-klappentext {
		background-color: var(--bg);
		padding: 2rem 0 5rem;
	}

	.g-klappentext-inner {
		max-width: 680px;
		margin-inline: auto;
	}

	.g-body {
		font-family: 'Manrope', sans-serif;
		font-size: 16px;
		font-weight: 300;
		line-height: 1.7;
		color: var(--muted);
		margin: 0 0 1.25rem;
	}

	.g-body:last-of-type {
		margin-bottom: 0;
	}

	/* 4. WORKSHOP – character slider + info */
	.g-workshop.full-bleed {
		width: 100vw;
		margin-left: calc(50% - 50vw);
		box-sizing: border-box;
		background-color: var(--bg);
		color: var(--text);
		padding: 2rem var(--page-padding-desktop) 2.5rem;
	}

	.g-workshop-inner {
		max-width: 1000px;
		margin-inline: auto;
	}

	.g-workshop-subtitle {
		font-family: 'Manrope', sans-serif;
		font-size: 16px;
		font-weight: 300;
		line-height: 1.7;
		color: var(--muted);
		text-align: center;
		margin: 0 0 -0.75rem 0;
	}

	@media (min-width: 1025px) {
		.g-workshop-subtitle {
			margin: 0 0 -2.25rem 0;
		}
	}

	.g-char-info {
		background-color: var(--bg);
		padding: 1rem 0 1.25rem;
		min-height: 0;
		box-sizing: border-box;
		text-align: center;
		max-width: 42rem;
		margin-inline: auto;
	}

	.g-char-info .g-eyebrow {
		margin-bottom: 0.5rem;
		color: #C13A00;
	}

	.g-char-desc {
		font-family: 'Manrope', sans-serif;
		font-size: 16px;
		font-weight: 300;
		line-height: 1.7;
		color: var(--muted);
		margin: 0;
	}

	/* 3. VIDEO */
	.g-video {
		background-color: var(--bg);
		padding: 2rem 0 3rem;
	}

	.g-video-inner {
		max-width: 800px;
		margin-inline: auto;
	}

	.g-section-title {
		font-family: 'Manrope', sans-serif;
		font-size: 21px;
		font-weight: 700;
		color: var(--text);
		margin: 0 0 1.5rem;
		text-align: center;
	}

	/* 5. NETFLIX */
	.g-netflix {
		background-color: var(--bg);
		padding: 3rem 0 3rem;
	}

	.g-netflix-inner {
		max-width: 800px;
		margin-inline: auto;
	}

	.g-section-title--center {
		text-align: center;
		margin-bottom: 2.5rem;
	}

	.g-netflix-grid {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		gap: 2.5rem;
	}

	.g-netflix-col {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.g-netflix h3 {
		font-family: 'Manrope', sans-serif;
		font-size: 1.1rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin: 0;
		color: #FBA922;
	}

	.g-netflix-text {
		font-family: 'Manrope', sans-serif;
		font-size: 16px;
		font-weight: 300;
		line-height: 1.7;
		color: var(--muted);
		margin: 0;
	}

	@media (max-width: 1024px) {
		.g-netflix-grid {
			grid-template-columns: 1fr;
