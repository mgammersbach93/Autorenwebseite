---
import Layout from '../layouts/Layout.astro';

const timelineEntries = [
	{
		year: '2019',
		headline: 'Die beste Sinnkrise meines Lebens',
		text: 'Eine Sinnkrise bringt mich zur Persönlichkeitsentwicklung – und verändert meinen Blick auf das Leben.',
	},
	{
		year: '2019',
		headline: 'Einstieg in die Persönlichkeitsentwicklung',
		text: 'Mit Lars Amends „Why Not?" entdecke ich die Welt der Persönlichkeitsentwicklung. Die praktischen Tipps machen meinen Alltag von Tag zu Tag aufregender.',
	},
	{
		year: '2020',
		headline: '5 schnelle Fragen an Tommi Schmitt',
		text: 'Ein Podcast-Moment zündet den Funken. Ich schreibe 300 Seiten – ohne zu wissen, wohin die Reise geht.',
	},
	{
		year: '2021–22',
		headline: 'Ich lerne das Schreibhandwerk',
		text: 'Ratgeber, Podcasts, Videos – jede freie Minute gehört dem Schreiben.',
	},
	{
		year: '2023',
		headline: 'Mein erster Roman',
		text: '„Sie wollten doch nur glücklich sein" erscheint – mein erstes veröffentlichtes Werk.',
	},
];
---

<Layout title="Über mich">

	<section class="hero">
		<div class="hero__inner">

			<!-- LEFT -->
			<div class="hero__left">
				<span class="eyebrow">Markus Gammersbach</span>
				<h1 class="hero__name">Über mich</h1>
				<div class="hero__divider"></div>
				<p class="hero__intro">
					Autor, Geschichtenerzähler und Millennial aus dem Rheinland.
					Ich schreibe über das Leben zwischen Aufbruch und Ankommen –
					ehrlich, direkt und nah dran an dem, was uns wirklich bewegt.
				</p>
			</div>

			<!-- RIGHT -->
			<div class="hero__right">
				<div class="hero__right-shape"></div>
				<img class="hero__right-photo" src="/images/markus-gammersbach-selfpublishing-autor.png" alt="Markus Gammersbach" />
			</div>

		</div>
	</section>

	<!-- SECTION: Timeline "Mein Weg zum Schreiben" -->
	<section id="zeitstrahl" class="ueber-timeline">
		<div class="ueber-timeline-inner">
			<h2 class="ueber-timeline-title">Mein Weg zum Schreiben</h2>
			<div class="timeline-items">
				<div class="timeline-line" aria-hidden="true"></div>
				{timelineEntries.map((entry, i) => {
					const isLeft = i % 2 === 0;
					const content = (
						<div class="timeline-content">
							<p class="timeline-year">{entry.year}</p>
							<h3 class="timeline-headline">{entry.headline}</h3>
							<p class="timeline-text">{entry.text}</p>
						</div>
					);
					const dotWrap = (
						<div class="timeline-dot-wrap">
							<span class="timeline-dot" aria-hidden="true"></span>
						</div>
					);
					const spacer = <div class="timeline-content timeline-content--spacer" aria-hidden="true"></div>;
					return (
						<div class={`timeline-item ${isLeft ? 'timeline-item--left' : 'timeline-item--right'}`}>
							{isLeft ? (
								<>
									{content}
									{dotWrap}
									{spacer}
								</>
							) : (
								<>
									{spacer}
									{dotWrap}
									{content}
								</>
							)}
						</div>
					);
				})}
			</div>
		</div>
	</section>

	<section class="ueber-quote-band">
		<div class="quote-band-inner">
			<span class="quote-mark" aria-hidden="true">„</span>
			<blockquote class="quote-text">
				Ein erfüllendes Hobby gibt mir mehr als der Druck, mit meinen Büchern maximalen Profit generieren zu müssen.
			</blockquote>
		</div>
	</section>

	<!-- SECTION: WAS MICH ANTREIBT (Off-White) -->
	<section class="ueber-antreibt">
		<div class="antreibt-inner">
			<h2 class="antreibt-title">Was mich antreibt</h2>

			<div class="antreibt-grid">
				<div class="antreibt-item">
					<div class="antreibt-img-wrap">
						<div class="antreibt-img-block"></div>
						<img class="antreibt-img" src="/images/markus-gammersbach-selfpublishing-autor.png" alt="Leidenschaft" />
					</div>
					<div class="antreibt-content">
						<p class="antreibt-eyebrow">Leidenschaft</p>
						<p class="antreibt-text">Das Schreiben ist für mich mehr als ein Hobby – es ist die Art, wie ich die Welt verarbeite und mit anderen teile.</p>
					</div>
				</div>

				<div class="antreibt-item">
					<div class="antreibt-img-wrap">
						<div class="antreibt-img-block"></div>
						<img class="antreibt-img" src="/images/markus-gammersbach-selfpublishing-autor.png" alt="Motivation" />
					</div>
					<div class="antreibt-content">
						<p class="antreibt-eyebrow">Motivation</p>
						<p class="antreibt-text">Die Frage „Was würde ich tun, wenn die Zeit begrenzt ist?" treibt mich an, keine Idee ungeschrieben zu lassen.</p>
					</div>
				</div>

				<div class="antreibt-item">
					<div class="antreibt-img-wrap">
						<div class="antreibt-img-block"></div>
						<img class="antreibt-img" src="/images/markus-gammersbach-selfpublishing-autor.png" alt="Vision" />
					</div>
					<div class="antreibt-content">
						<p class="antreibt-eyebrow">Vision</p>
						<p class="antreibt-text">Ich möchte Geschichten erzählen, die Leserinnen und Leser berühren und zu mehr Bewusstsein im Alltag anregen.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- SECTION 6 - MOIN & ALAAF (Off-White) -->
	<section class="ueber-moin">
		<div class="ueber-moin-inner">
			<div class="ueber-moin-content">
				<h2 class="ueber-section-title">Moin & Alaaf</h2>
				<p class="ueber-moin-sub">In Kölle jebore – in Hamburg zum Schreiben gekommen</p>
				<div class="ueber-moin-text">
					<p>In Köln geboren und mit dem Karneval groß geworden, lebe ich heute in Hamburg. Die Hansestadt hat mich zum Schreiben gebracht: die Ruhe am Wasser, die Weite der Elbe und die Kultur des Nordens haben den Raum geschaffen, in dem meine Geschichten entstehen. Köln bleibt Heimat – Hamburg ist der Ort, an dem ich Autor geworden bin.</p>
				</div>
			</div>
			<div class="ueber-moin-images">
				<div class="moin-image-wrap">
					<div class="moin-image-placeholder"></div>
					<p class="moin-image-label">Hamburg</p>
				</div>
				<div class="moin-image-wrap">
					<div class="moin-image-placeholder"></div>
					<p class="moin-image-label">Köln</p>
				</div>
			</div>
		</div>
	</section>

	<!-- SECTION 7 - KONTAKT (Smaragd, full width) -->
	<section class="ueber-kontakt full-width emerald" id="kontakt">
		<div class="ueber-kontakt-inner">
			<h2 class="ueber-kontakt-title">Kontakt</h2>
			<p class="ueber-kontakt-email">Du hast Fragen? Ich freue mich, von dir zu hören!</p>
			<form class="ueber-form" name="ueber-kontakt" method="POST" data-netlify="true" netlify-honeypot="bot">
				<input type="hidden" name="form-name" value="ueber-kontakt" />
				<p class="ueber-form-hp" hidden>
					<label>Nicht ausfüllen: <input name="bot" /></label>
				</p>
				<div class="ueber-form-row">
					<label for="ueber-name" class="ueber-form-label">Name</label>
					<input type="text" id="ueber-name" name="name" class="ueber-form-input" required autocomplete="name" />
				</div>
				<div class="ueber-form-row">
					<label for="ueber-email" class="ueber-form-label">E-Mail</label>
					<input type="email" id="ueber-email" name="email" class="ueber-form-input" required autocomplete="email" />
				</div>
				<div class="ueber-form-row">
					<label for="ueber-nachricht" class="ueber-form-label">Nachricht</label>
					<textarea id="ueber-nachricht" name="nachricht" class="ueber-form-textarea" rows="5" required></textarea>
				</div>
				<button type="submit" class="btn btn-primary ueber-form-submit">Absenden</button>
			</form>
		</div>
	</section>
</Layout>

<style>
	/* ── HERO ── */
	.hero {
		background: var(--bg);
		min-height: 100vh;
		display: flex;
		align-items: flex-start;
		padding: 8rem 5rem 0;
		position: relative;
		overflow: visible;
	}

	.hero__inner {
		max-width: 1300px;
		width: 100%;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 6rem;
		align-items: center;
		overflow: visible;
	}

	.hero__left {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.eyebrow {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: var(--gold);
	}

	.hero__name {
		font-size: 64px;
		font-weight: 700;
		line-height: 1.0;
		letter-spacing: -0.02em;
		color: var(--text);
	}

	.hero__divider {
		width: 48px;
		height: 2px;
		background: var(--gold);
	}

	.hero__intro {
		font-size: 16px;
		font-weight: 300;
		line-height: 1.7;
		color: var(--muted);
		max-width: 420px;
	}

	.btn-primary {
		display: inline-block;
		background: var(--btn-primary);
		color: var(--bg);
		padding: 0.85rem 2rem;
		font-family: 'Manrope', sans-serif;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		text-decoration: none;
		border: none;
		cursor: pointer;
		width: fit-content;
		transition: background 0.2s;
	}
	.btn-primary:hover { background: var(--btn-primary-hover); }

	.hero__right {
		position: relative;
		height: 520px;
		align-self: flex-end;
	}

	.hero__right-shape {
		position: absolute;
		width: 460px;
		height: 400px;
		background: #1a3a30;
		bottom: 0;
		left: 50%;
		transform: translateX(-50%);
		border-radius: 60px 60px 0 0;
	}

	.hero__right-photo {
		position: absolute;
		width: 420px;
		height: 580px;
		object-fit: cover;
		object-position: center top;
		bottom: 0;
		left: 50%;
		transform: translateX(-50%);
		display: block;
	}

	/* ── MOBILE ── */
	@media (max-width: 768px) {
		.hero {
			padding: 7rem 1.5rem 4rem;
			min-height: auto;
			align-items: flex-start;
		}
		.hero__inner {
			grid-template-columns: 1fr;
			gap: 3rem;
		}
		.hero__left { order: 2; }
		.hero__right { order: 1; height: 400px; }
		.hero__name { font-size: 42px; }
		.hero__right-shape { width: 260px; height: 320px; }
		.hero__right-photo { width: 240px; height: 380px; }
	}

	/* Full-width Smaragd sections */
	.full-width {
		width: 100vw;
		margin-left: calc(50% - 50vw);
		box-sizing: border-box;
	}

	.full-width.emerald {
		background-color: var(--emerald);
		color: var(--bg);
	}

	/* SECTION: Was mich antreibt */
	.ueber-antreibt {
		background-color: var(--bg);
		padding-block: 7rem 8rem;
	}

	.antreibt-inner {
		max-width: 1300px;
		margin-inline: auto;
		padding-inline: 5rem;
	}

	.antreibt-title {
		font-family: 'Manrope', sans-serif;
		font-size: 28px;
		font-weight: 700;
		color: var(--text);
		margin: 0 0 3rem;
		text-align: center;
	}

	.antreibt-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
	}

	.antreibt-item {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.antreibt-img-wrap {
		position: relative;
		width: 100%;
		display: flex;
		justify-content: center;
		align-items: flex-end;
	}

	.antreibt-img-block {
		position: absolute;
		bottom: 0;
		left: 50%;
		transform: translateX(-50%);
		width: 260px;
		height: 260px;
		background-color: var(--emerald);
		border-radius: 40px 40px 0 0;
		z-index: 1;
	}

	.antreibt-img {
		position: relative;
		z-index: 2;
		width: 100%;
		max-width: 340px;
		height: auto;
		display: block;
	}

	.antreibt-content {
		padding: 1.5rem 1rem 0;
		text-align: center;
	}

	.antreibt-eyebrow {
		font-family: 'Manrope', sans-serif;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--gold);
		margin: 0 0 0.75rem;
	}

	.antreibt-text {
		font-family: 'Manrope', sans-serif;
		font-size: 16px;
		font-weight: 300;
		line-height: 1.7;
		color: var(--muted);
		margin: 0;
	}

	/* Tablet responsive */
	@media (max-width: 1100px) and (min-width: 901px) {
		.antreibt-grid {
			gap: 1.5rem;
		}

		.antreibt-img-block {
			width: 200px;
			height: 200px;
			border-radius: 32px 32px 0 0;
		}

		.antreibt-img {
			max-width: 260px;
		}

		.antreibt-content {
			padding: 1rem 0.5rem 0;
		}

	}

	@media (max-width: 900px) {
		.antreibt-inner {
			padding-inline: 2rem;
		}

		.antreibt-grid {
			grid-template-columns: 1fr;
			gap: 3.5rem;
			max-width: 360px;
			margin-inline: auto;
		}

		.antreibt-img-block {
			width: 220px;
			height: 220px;
			border-radius: 32px 32px 0 0;
		}
	}

	.ueber-section-title {
		font-family: 'Manrope', sans-serif;
		font-size: clamp(1.6rem, 2.5vw, 2rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		margin: 0 0 var(--space-5);
		color: var(--text);
	}

	/* SECTION: Timeline */
	.ueber-timeline {
		background-color: #f5f0e8;
		padding-block: 0 6rem;
	}

	.ueber-timeline-inner {
		position: relative;
		max-width: 800px;
		margin-inline: auto;
		padding-inline: 2rem;
	}

	.ueber-timeline-title {
		font-family: 'Manrope', sans-serif;
		font-size: 28px;
		font-weight: 700;
		text-align: center;
		margin: 0 0 3rem;
		color: var(--text);
	}

	.timeline-items {
		position: relative;
	}

	.timeline-line {
		position: absolute;
		left: 50%;
		top: 0;
		bottom: 0;
		width: 1px;
		background: rgba(28, 28, 28, 0.12);
		transform: translateX(-50%);
		pointer-events: none;
	}

	.timeline-item {
		display: grid;
		grid-template-columns: 1fr 20px 1fr;
		gap: 0;
		margin-bottom: 3rem;
		align-items: start;
	}

	.timeline-item:last-child {
		margin-bottom: 0;
	}

	.timeline-item--left .timeline-content:first-child {
		grid-column: 1;
		text-align: right;
		padding-right: 3rem;
	}

	.timeline-item--left .timeline-dot-wrap { grid-column: 2; }
	.timeline-item--left .timeline-content--spacer { grid-column: 3; }

	.timeline-item--right .timeline-content:not(.timeline-content--spacer) {
		grid-column: 3;
		text-align: left;
		padding-left: 3rem;
	}

	.timeline-item--right .timeline-dot-wrap { grid-column: 2; }
	.timeline-item--right .timeline-content--spacer { grid-column: 1; }

	.timeline-dot-wrap {
		display: flex;
		align-items: flex-start;
		justify-content: center;
		padding-top: 0;
		align-self: start;
	}

	.timeline-dot {
		display: block;
		width: 10px;
		height: 10px;
		background-color: var(--gold);
		transform: rotate(45deg);
		flex-shrink: 0;
	}

	.timeline-year {
		font-family: 'Manrope', sans-serif;
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: var(--gold);
		margin: 0 0 0.3rem;
	}

	.timeline-headline {
		font-family: 'Manrope', sans-serif;
		font-size: 16px;
		font-weight: 600;
		color: var(--text);
		margin: 0 0 0.5rem;
	}

	.timeline-text {
		font-family: 'Manrope', sans-serif;
		font-size: 16px;
		font-weight: 300;
		line-height: 1.7;
		color: var(--muted);
		margin: 0;
	}

	/* SECTION: Quote (Smaragd band) */
	.ueber-quote-band {
		width: 100vw;
		margin-left: calc(50% - 50vw);
		background-color: var(--emerald);
		padding-block: 5rem;
		box-sizing: border-box;
	}

	.quote-band-inner {
		max-width: 800px;
		margin-inline: auto;
		padding-inline: 2rem;
		text-align: center;
	}

	.ueber-quote-band .quote-mark {
		display: block;
		font-family: Georgia, serif;
		font-size: 5rem;
		font-weight: 300;
		line-height: 0.5;
		color: var(--gold);
		opacity: 0.6;
		margin-bottom: 1.5rem;
	}

	.ueber-quote-band .quote-text {
		font-family: 'Manrope', sans-serif;
		font-size: 24px;
		font-weight: 300;
		font-style: italic;
		line-height: 1.6;
		color: #f5f0e8;
		margin: 0;
	}

	/* SECTION: Moin & Alaaf */
	.ueber-moin {
		background-color: var(--bg);
		padding-block: 5rem 8.5rem;
	}

	.ueber-moin-inner {
		max-width: 1300px;
		margin-inline: auto;
		padding-inline: 5rem;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: center;
	}

	.ueber-moin-content {
		display: flex;
		flex-direction: column;
	}

	.ueber-moin-sub {
		font-family: 'Manrope', sans-serif;
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: var(--muted);
		margin: 0 0 1.5rem;
	}

	.ueber-moin-text p {
		font-family: 'Manrope', sans-serif;
		font-size: 16px;
		font-weight: 300;
		line-height: 1.7;
		margin: 0;
		color: var(--muted);
	}

	.ueber-moin-images {
		display: flex;
		gap: 1.5rem;
		justify-content: center;
	}

	.moin-image-wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.moin-image-placeholder {
		width: 180px;
		height: 240px;
		background-color: rgba(26, 58, 48, 0.15);
		border: 1px dashed var(--emerald);
	}

	.moin-image-label {
		font-family: 'Manrope', sans-serif;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--gold);
		margin: 0;
	}

	@media (max-width: 900px) {
		.ueber-moin-inner {
			grid-template-columns: 1fr;
			gap: 3rem;
			padding-inline: 2rem;
		}

		.ueber-moin-images {
			order: 1;
		}

		.moin-image-placeholder {
			width: 150px;
			height: 200px;
		}
	}

	@media (max-width: 720px) {
		.ueber-moin {
			padding-block: 3rem 5.5rem;
		}

		.ueber-moin-inner {
			padding-inline: 1.5rem;
		}

		.moin-image-placeholder {
			width: 130px;
			height: 170px;
		}
	}

	/* SECTION: Kontakt */
	.ueber-kontakt {
		padding-block: 5rem 6rem;
		scroll-margin-top: 120px;
	}

	/* Match in-flow sections: container padding + inner padding (full-width breaks out of .container) */
	.ueber-kontakt-inner {
		max-width: 1300px;
		margin-inline: auto;
		padding-inline: calc(var(--page-padding-desktop) * 2);
	}

	@media (max-width: 960px) {
		/* Layout .container 2rem + antreibt-inner still 5rem above 900px */
		.ueber-kontakt-inner {
			padding-inline: 7rem;
		}
	}

	@media (max-width: 900px) {
		/* .container 2rem + antreibt-inner 2rem */
		.ueber-kontakt-inner {
			padding-inline: 4rem;
		}
	}

	@media (max-width: 720px) {
		/* .container 1.5rem + antreibt-inner 2rem */
		.ueber-kontakt-inner {
			padding-inline: 3.5rem;
		}
	}

	.ueber-kontakt-title {
		font-family: 'Manrope', sans-serif;
		font-size: clamp(1.6rem, 2.5vw, 2rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		margin: 0 0 var(--space-2);
		color: var(--bg);
