---
import Layout from '../layouts/Layout.astro';

const timelineEntries = [
	{
		year: '2019',
		headline: 'Die beste Sinnkrise meines Lebens',
		text: 'Im Sommer 2019 mache ich mir viele Gedanken: Was will ich eigentlich im Leben? Bin ich noch auf dem richtigen Weg? Nutze ich meine Zeit sinnvoll?',
	},
	{
		year: '2019',
		headline: 'Ein Buch, das alles verändert',
		text: 'Mit Lars Amends „Why Not?" entdecke ich die Welt der Persönlichkeitsentwicklung. Von nun an probiere ich zahlreiche Ansätze aus, stoße Veränderungen an und lasse meine Sinnkrise damit schnell hinter mir.',
	},
	{
		year: '2019–20',
		headline: 'Eine schnelle Frage an Tommi Schmitt',
		text: 'Nach einer Folge „Gemischtes Hack" habe ich plötzlich den Drang, meine eigenen Erfahrungen mit der Persönlichkeitsentwicklung aufzuschreiben.',
	},
	{
		year: '2020–21',
		headline: 'Mein erstes Buchprojekt',
		text: 'Zur selben Zeit bin ich auf der Suche nach einem Ventil für meine Kreativität. Aus den losen Ideen wird ein Ratgeber für Millennials.',
	},
	{
		year: '2021–23',
		headline: 'Deep Dive ins Schreibhandwerk',
		text: 'Über ein Jahr lang nutze ich jede freie Minute, um mir das Schreibhandwerk beizubringen. Mein Ziel: Ich möchte einen eigenen Roman schreiben.',
	},
	{
		year: '2023',
		headline: 'Mein erster Roman',
		text: 'Nach eineinhalb Jahren Arbeit erscheint „Sie wollten doch nur glücklich sein" im Self-Publishing bei Amazon.',
	},
	{
		year: '2023–heute',
		headline: 'Schreiben als fester Teil meines Lebens',
		text: 'Schreiben ist ein wichtiger Bestandteil meiner Freizeit und ich versuche, so viel Zeit wie möglich damit zu verbringen.',
	},
];
---

<Layout
	title="Markus Gammersbach | Self-Publishing-Autor"
	description="Mein Name ist Markus Gammersbach. Du suchst nach inspirierenden Romanen, die dich weiterbringen? Dann bist du hier genau richtig!"
	image="/images/markus-gammersbach-selfpublishing-autor.png"
>

	<section class="hero">
		<div class="hero__inner">

			<!-- LEFT -->
			<div class="hero__left">
				<span class="eyebrow">Markus Gammersbach</span>
				<h1 class="hero__name">Über mich</h1>
				<div class="hero__divider"></div>
				<p class="hero__intro">
					Self-Publishing-Autor und Millennial aus Köln. Ich schreibe Romane über Persönlichkeitsentwicklung.
				</p>
			</div>

			<!-- RIGHT -->
			<div class="hero__right">
				<div class="hero__right-shape"></div>
				<img class="hero__right-photo" src="/images/markus-gammersbach-selfpublishing-autor.png" alt="Markus Gammersbach" />
			</div>

		</div>
	</section>

	<!-- SECTION: Timeline "Mein Weg zum Schreiben" -->
	<section id="zeitstrahl" class="ueber-timeline">
		<div class="ueber-timeline-inner">
			<h2 class="ueber-timeline-title">Mein Weg zum Schreiben</h2>
			<div class="timeline-items">
				<div class="timeline-line" aria-hidden="true"></div>
				{timelineEntries.map((entry, i) => {
					const isLeft = i % 2 === 0;
					const content = (
						<div class="timeline-content">
							<p class="timeline-year">{entry.year}</p>
							<h3 class="timeline-headline">{entry.headline}</h3>
							<p class="timeline-text">{entry.text}</p>
						</div>
					);
					const dotWrap = (
						<div class="timeline-dot-wrap">
							<span class="timeline-dot" aria-hidden="true"></span>
						</div>
					);
					const spacer = <div class="timeline-content timeline-content--spacer" aria-hidden="true"></div>;
					return (
						<div class={`timeline-item ${isLeft ? 'timeline-item--left' : 'timeline-item--right'}`}>
							{isLeft ? (
								<>
									{content}
									{dotWrap}
									{spacer}
								</>
							) : (
								<>
									{spacer}
									{dotWrap}
									{content}
								</>
							)}
						</div>
					);
				})}
			</div>
		</div>
	</section>

	<!-- SECTION: Meine Vision (full-width smaragd) -->
	<section class="ueber-vision" aria-labelledby="ueber-vision-eyebrow">
		<div class="ueber-vision-inner">
			<div class="ueber-vision-placeholder ueber-vision-placeholder--tr">
				<img
					class="ueber-vision-placeholder-img"
					src="/images/markus-gammersbach-roman-schreiben.JPG"
					alt="Markus Gammersbach beim Schreiben eines Romans am Laptop"
					loading="lazy"
					decoding="async"
				/>
			</div>
			<div class="ueber-vision-content">
				<p id="ueber-vision-eyebrow" class="ueber-vision-eyebrow">Meine Vision</p>
				<p class="ueber-vision-statement">
					Ich möchte meinen Beitrag dazu leisten, dass wir häufiger zum Buch statt zum Handy greifen.
				</p>
				<p class="ueber-vision-support">
					Mit Geschichten, die inspirieren und bei der persönlichen Entwicklung helfen.
				</p>
			</div>
			<div class="ueber-vision-placeholder ueber-vision-placeholder--bl">
				<img
					class="ueber-vision-placeholder-img"
					src="/images/markus-gammersbach-lesen.JPG"
					alt="Markus Gammersbach beim Lesen"
					loading="lazy"
					decoding="async"
				/>
			</div>
		</div>
	</section>

	<!-- SECTION: So schreibe ich -->
	<section class="ueber-schreibprozess" aria-labelledby="ueber-schreibprozess-heading">
		<div class="ueber-schreibprozess-inner">
			<header class="ueber-schreibprozess-header">
				<h2 id="ueber-schreibprozess-heading" class="ueber-schreibprozess-title">So schreibe ich</h2>
			</header>

			<div class="schreibprozess-grid">
				<div class="schreibprozess-item">
					<svg class="schreibprozess-item-icon" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#B89A3E" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
					<h3 class="schreibprozess-item-title">Frühaufsteher</h3>
					<p class="schreibprozess-item-desc">Am liebsten schreibe ich am Wochenende zwischen 07:30 und 12:00 Uhr nach einem Morgenspaziergang.</p>
				</div>

				<div class="schreibprozess-item">
					<svg class="schreibprozess-item-icon" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#B89A3E" stroke-width="1.5" aria-hidden="true"><path d="M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3V6z"/><path d="M9 3v15M15 6v15"/></svg>
					<h3 class="schreibprozess-item-title">Plotter</h3>
					<p class="schreibprozess-item-desc">Ich brauche Struktur in meinen Büchern. Bevor ich ein Kapitel ausformuliere, weiß ich schon, was darin passieren wird.</p>
				</div>

				<div class="schreibprozess-item">
					<svg class="schreibprozess-item-icon" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#B89A3E" stroke-width="1.5" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M2 17h20M6 21h12"/></svg>
					<h3 class="schreibprozess-item-title">Papyrus</h3>
					<p class="schreibprozess-item-desc">Ich vertraue auf eines der bekanntesten Schreibprogramme, um den Überblick über meine Geschichten zu behalten.</p>
				</div>

				<div class="schreibprozess-item">
					<svg class="schreibprozess-item-icon" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#B89A3E" stroke-width="1.5" aria-hidden="true"><path d="M3 18v-6a9 9 0 1 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3v5zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3v5z"/></svg>
					<h3 class="schreibprozess-item-title">Lo-Fi Beats</h3>
					<p class="schreibprozess-item-desc">Instrumentale Musik hilft mir, in den Flow zu kommen und ohne Ablenkungen einfach draufloszuschreiben.</p>
				</div>

				<div class="schreibprozess-item">
					<svg class="schreibprozess-item-icon" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#B89A3E" stroke-width="1.5" aria-hidden="true"><rect x="2" y="7" width="18" height="10" rx="2"/><path d="M22 11v2"/><path d="M6 11v2M10 11v2M14 11v2"/></svg>
					<h3 class="schreibprozess-item-title">Nebenberuflich</h3>
					<p class="schreibprozess-item-desc">Für mich ist Schreiben ein Hobby, das mich die Zeit vergessen lässt und mit dem ich kein Geld verdienen muss.</p>
				</div>

				<div class="schreibprozess-item">
					<svg class="schreibprozess-item-icon" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#B89A3E" stroke-width="1.5" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
					<h3 class="schreibprozess-item-title">Schreibkollektiv</h3>
					<p class="schreibprozess-item-desc">Seit 2024 bin ich Teil vom Schreibkollektiv Köln und treffe mich regelmäßig mit anderen zum gemeinsamen Schreiben.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- SECTION 6 - MOIN & ALAAF (Off-White) -->
	<section class="ueber-moin">
		<div class="ueber-moin-inner">
			<div class="ueber-moin-content">
				<h2 class="ueber-section-title">Moin & Alaaf</h2>
				<p class="ueber-moin-sub">In Kölle jebore – in Hamburg zum Schreiben gekommen</p>
				<div class="ueber-moin-text">
					<p>Vier Jahre habe ich als gebürtiger Kölner in Hamburg gelebt. Dom- und Hansestadt kombinieren so ziemlich alles, was ich in meinem Alltag brauche: Die Ruhe im Norden mit der kölschen Offenheit. Das Leben in der Großstadt mit Rückzugsorten am Wasser. Die Nähe zum Meer mit der Nähe zu Familie und Freunden.</p>
				</div>
			</div>
			<div class="ueber-moin-images">
				<div class="moin-image-wrap">
					<div class="moin-image-frame">
						<img
							class="moin-image-img"
							src="/images/markus-gammersbach-hamburg.jpg"
							alt="Markus Gammersbach in Hamburg"
							loading="lazy"
							decoding="async"
						/>
					</div>
					<p class="moin-image-label">Hamburg</p>
				</div>
				<div class="moin-image-wrap">
					<div class="moin-image-frame">
						<img
							class="moin-image-img"
							src="/images/markus-gammersbach-koeln.jpg"
							alt="Markus Gammersbach in Köln"
							loading="lazy"
							decoding="async"
						/>
					</div>
					<p class="moin-image-label">Köln</p>
				</div>
			</div>
		</div>
	</section>

	<!-- SECTION 7 - KONTAKT (Smaragd, full width) -->
	<section class="ueber-kontakt full-width emerald" id="kontakt">
		<div class="ueber-kontakt-inner">
			<h2 class="ueber-kontakt-title">Kontakt</h2>
			<p class="ueber-kontakt-email">Du hast Fragen? Ich freue mich, von dir zu hören!</p>
			<form class="ueber-form" name="ueber-kontakt" method="POST" data-netlify="true" netlify-honeypot="bot">
				<input type="hidden" name="form-name" value="ueber-kontakt" />
				<p class="ueber-form-hp" hidden>
					<label>Nicht ausfüllen: <input name="bot" /></label>
				</p>
				<div class="ueber-form-row">
					<label for="ueber-name" class="ueber-form-label">Name</label>
					<input type="text" id="ueber-name" name="name" class="ueber-form-input" required autocomplete="name" />
				</div>
				<div class="ueber-form-row">
					<label for="ueber-email" class="ueber-form-label">E-Mail</label>
					<input type="email" id="ueber-email" name="email" class="ueber-form-input" required autocomplete="email" />
				</div>
				<div class="ueber-form-row">
					<label for="ueber-nachricht" class="ueber-form-label">Nachricht</label>
					<textarea id="ueber-nachricht" name="nachricht" class="ueber-form-textarea" rows="5" required></textarea>
				</div>
				<label class="ueber-form-consent">
					<input type="checkbox" name="datenschutz" required />
					<span>Ich habe die <a href="/datenschutz" target="_blank">Datenschutzerklärung</a> gelesen und stimme der Verarbeitung meiner Daten zu.</span>
				</label>
				<button type="submit" class="btn btn-primary ueber-form-submit">Absenden</button>
			</form>
			<div class="ueber-form-success" id="form-success" style="display:none;">
				<div class="ueber-form-success-icon">
					<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#B89A3E" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
				</div>
				<h3 class="ueber-form-success-title">Vielen Dank!</h3>
				<p class="ueber-form-success-text">Deine Nachricht ist angekommen. Ich melde mich so schnell wie möglich.</p>
			</div>
		</div>
	</section>
</Layout>

<style>
	/* ── HERO (wide desktop + tablet stack aligned with warum-lesen) ── */
	.hero {
		background: var(--bg);
		min-height: 100vh;
		display: flex;
		align-items: center;
		padding: 8rem 5rem 0;
		position: relative;
		overflow: visible;
	}

	.hero__inner {
		max-width: 1300px;
		width: 100%;
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 6rem;
		align-items: center;
		overflow: visible;
	}

	.hero__left {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.eyebrow {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: var(--gold);
	}

	.hero__name {
		font-size: 64px;
		font-weight: 700;
		line-height: 1.0;
		letter-spacing: -0.02em;
		color: var(--text);
		margin: 0;
	}

	.hero__divider {
		width: 48px;
		height: 2px;
		background: var(--gold);
	}

	.hero__intro {
		font-size: 16px;
		font-weight: 300;
		line-height: 1.7;
		color: var(--muted);
		max-width: 420px;
		margin: 0;
	}

	.btn-primary {
		display: inline-block;
		background: var(--btn-primary);
		color: var(--bg);
		padding: 0.85rem 2rem;
		font-family: 'Manrope', sans-serif;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		text-decoration: none;
		border: none;
		cursor: pointer;
		width: fit-content;
		transition: background 0.2s;
	}
	.btn-primary:hover { background: var(--btn-primary-hover); }

	.hero__right {
		position: relative;
		height: 520px;
		align-self: center;
		width: 100%;
		max-width: 520px;
		margin-inline: auto;
	}

	.hero__right-shape {
		position: absolute;
		width: min(520px, 100%);
		height: auto;
		aspect-ratio: 520 / 400;
		background: var(--emerald);
		bottom: 0;
		left: 50%;
		transform: translateX(-50%);
		border-radius: 60px 60px 0 0;
	}

	.hero__right-photo {
		position: absolute;
		bottom: 0;
		left: 50%;
		transform: translateX(-50%);
		display: block;
		width: auto;
		height: auto;
		max-height: 580px;
		max-width: min(100%, 520px);
		object-fit: contain;
		object-position: bottom center;
	}

	@media (max-width: 960px) {
		.hero {
			padding: 8rem 2rem 0;
		}
	}

	@media (max-width: 1368px) {
		.hero {
			align-items: center;
			min-height: auto;
			padding: 6rem 2rem 2.5rem;
		}

		.hero__inner {
			grid-template-columns: 1fr;
			gap: 1.5rem;
			text-align: center;
			align-items: center;
		}

		.hero__left {
			align-items: center;
			order: 2;
			gap: 1.25rem;
		}

		.hero__right {
			order: 1;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: flex-end;
			height: auto;
			width: 100%;
			max-width: none;
			margin-inline: 0;
			align-self: center;
		}

		.hero__divider {
			margin-inline: auto;
		}

		.hero__right-shape {
			position: absolute;
			width: 325px;
			height: 255px;
			aspect-ratio: unset;
			border-radius: 36px 36px 0 0;
			background: var(--emerald);
		}

		.hero__right-photo {
			position: relative;
			z-index: 2;
			left: auto;
			bottom: auto;
			transform: none;
			width: 100%;
			max-width: 360px;
			height: auto;
			max-height: none;
			object-fit: contain;
			object-position: bottom center;
		}

		.hero__name {
			font-size: clamp(2.25rem, 5vw + 0.75rem, 3.5rem);
			line-height: 1.05;
		}
	}

	@media (max-width: 1368px) and (max-height: 820px) {
		.hero {
			padding-top: 5.25rem;
			padding-bottom: 2rem;
		}
	}

	@media (max-width: 768px) {
		.hero {
			padding: 5rem 1rem 3rem;
		}

		.hero__left {
			gap: 1rem;
		}

		.hero__name {
			font-size: 36px;
			line-height: 1.05;
		}

		.hero__intro {
			max-width: 280px;
			margin-inline: auto;
		}
	}

	@media (max-width: 720px) {
		.hero {
			padding-inline: 1.5rem;
		}
	}

	@media (max-width: 380px) {
		.hero__name {
			font-size: 32px;
		}

		.hero__right-photo {
			max-width: 280px;
		}

		.hero__right-shape {
			width: 255px;
			height: 200px;
			border-radius: 32px 32px 0 0;
		}
	}

	@media (min-width: 769px) {
		.hero {
			min-height: auto;
		}
	}

	@media (min-width: 1369px) {
		.hero {
			padding-bottom: 8.5rem;
		}
	}

	/* Full-width Smaragd sections */
	.full-width {
		width: 100vw;
		margin-left: calc(50% - 50vw);
		box-sizing: border-box;
	}

	.full-width.emerald {
		background-color: var(--emerald);
		color: var(--bg);
	}

	/* SECTION: Meine Vision */
	.ueber-vision {
		--vision-bg: #234f42;
		--vision-gold: #b89a3e;
		--vision-cream: #f5f0e8;
		--vision-section-pad-y: 5rem;
		--vision-placeholder-w: clamp(220px, 22vw, 300px);
		width: 100vw;
		max-width: none;
		margin-left: calc(50% - 50vw);
		box-sizing: border-box;
		background-color: var(--vision-bg);
		padding-block: 5rem;
		text-align: center;
		overflow: visible;
	}

	.ueber-vision-inner {
		position: relative;
		max-width: 800px;
		margin-inline: auto;
		padding-inline: 1.5rem;
		overflow: visible;
	}

	.ueber-vision-placeholder {
		display: none;
		pointer-events: none;
		position: absolute;
		z-index: 0;
		width: var(--vision-placeholder-w);
		aspect-ratio: 4 / 5;
		height: auto;
		box-sizing: border-box;
		border-radius: 14px;
		overflow: hidden;
	}

	.ueber-vision-placeholder-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		display: block;
	}

	.ueber-vision-content {
		position: relative;
		z-index: 1;
	}

	.ueber-vision-eyebrow {
		font-family: 'Manrope', sans-serif;
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.28em;
		color: var(--vision-gold);
		margin: 0 0 1.5rem;
	}

	.ueber-vision-statement {
		font-family: Georgia, 'Times New Roman', Times, serif;
		font-size: 22px;
		font-weight: 400;
		line-height: 1.5;
		color: var(--vision-cream);
		margin: 0 auto;
		max-width: 700px;
	}

	.ueber-vision-support {
		font-family: Georgia, 'Times New Roman', Times, serif;
		font-size: 22px;
		font-weight: 400;
		line-height: 1.5;
		color: var(--vision-cream);
		margin: 1.5rem auto 0;
		max-width: 700px;
	}

	@media (min-width: 769px) {
		.ueber-vision {
			--vision-section-pad-y: 10rem;
			padding-block: 10rem;
			text-align: left;
		}

		.ueber-vision-inner {
			position: relative;
			z-index: 1;
			max-width: 1100px;
			padding-inline: 5rem;
			min-height: 400px;
			display: flex;
			flex-direction: column;
		}

		.ueber-vision-placeholder {
