---
import Layout from '../layouts/Layout.astro';

const characterImages = {
	malte: '/images/gluecklich-sein-malte.png',
	lea: '/images/gluecklich-sein-lea.png',
	elias: '/images/gluecklich-sein-elias.png',
	sofia: '/images/gluecklich-sein-sofia.png',
};

const characters = [
	{
		id: 'malte',
		name: 'Malte',
		role: 'Leitet den Workshop',
		description:
			'Malte liebt es, andere dabei zu unterstützen, glücklich und unbeschwerter zu werden. Aufgrund seiner Depression gelingt ihm das allerdings im eigenen Alltag immer seltener.',
	},
	{
		id: 'lea',
		name: 'Lea',
		role: 'Sucht die große Liebe',
		description:
			'Lea möchte vor ihrem 30. Geburtstag unbedingt einen Partner finden. Bis jetzt stolpert sie von einem Online-Date ins nächste und verliert dabei so langsam ihren Optimismus.',
	},
	{
		id: 'elias',
		name: 'Elias',
		role: 'Sucht einen erfüllenden Job',
		description:
			'Elias will endlich wieder Spaß am Arbeiten haben, weiß aber nicht, wonach er suchen soll. Aus Angst vor Veränderung verharrt er seit Jahren in seinem ungeliebten Bürojob.',
	},
	{
		id: 'sofia',
		name: 'Sofia',
		role: 'Liebt die Karriere',
		description:
			'Sofia ist die jüngste Senior Sales Managerin bei einem führenden eCommerce-Anbieter. Dafür hat sie in den vergangenen Jahren hart gearbeitet – und auf vieles verzichtet.',
	},
];
---

<Layout title="Sie wollten doch nur glücklich sein">
	<!-- 1. HERO (Off-White) -->
	<section class="g-hero">
		<div class="g-hero-inner">
			<div class="g-hero-cover-wrap">
				<img
					src="/images/sie-wollten-doch-nur-gluecklich-sein.jpg"
					alt="Buchcover: Sie wollten doch nur glücklich sein"
					class="g-hero-cover"
				/>
			</div>
			<div class="g-hero-content">
				<h1 class="g-eyebrow">SIE WOLLTEN DOCH NUR GLÜCKLICH SEIN</h1>
				<p class="g-hero-title">Eine Geschichte über Millennials auf der Suche</p>
				<a href="https://www.amazon.de/wollten-doch-gl%C3%BCcklich-Generation-Millennials/dp/B0CKGWZ2WG/ref=tmm_pap_swatch_0" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Jetzt bestellen</a>
			</div>
		</div>
	</section>

	<!-- 2. KLAPPENTEXT (Off-White) -->
	<section class="g-klappentext">
		<div class="g-klappentext-inner">
			<p class="g-body">
				Elias sehnt sich nach einem erfüllenden Job, Lea möchte vor ihrem 30. Geburtstag unbedingt einen Partner finden, Malte belasten seine Depressionen in der Ehe und Sofia steht kurz vor der nächsten Beförderung.
			</p>
			<p class="g-body">
				In einem Workshop für Millennials lernen sich die vier kennen. Gemeinsam sprechen sie über Herausforderungen ihrer Generation und den Umgang mit persönlichen Sinnkrisen.
			</p>
			<p class="g-body">
				Der Kurs wird urplötzlich zur Nebensache, als das Rheinland im Hochwasser versinkt. Eine ganze Region steht unter Schock. Die Aufräumarbeiten in den betroffenen Gebieten entwickeln sich zu einer emotionalen Reise, die das Leben von Elias, Lea, Malte und Sofia für immer verändern wird.
			</p>
		</div>
	</section>

	<!-- 3. WORKSHOP (Emerald, full-width) -->
	<section class="g-workshop full-bleed">
		<div class="g-workshop-inner">
			<h2>Der Millennial Workshop</h2>
			<p class="g-workshop-subtitle">Klicke auf eine Person, um mehr zu erfahren</p>
			<div class="g-characters-row">
				<button type="button" class="g-char-nav g-char-nav-prev" aria-label="Vorherige Person">
					<span aria-hidden="true">‹</span>
				</button>
				<div class="g-characters">
					{characters.map((c) => (
						<button
							type="button"
							class="g-char-card"
							data-char={c.id}
							aria-pressed={c.id === 'malte'}
							aria-label={`${c.name} – ${c.role}`}
						>
							<div class="g-char-card-visual">
								<div class="g-char-card-center">
									<div class="g-char-card-bg" aria-hidden="true"></div>
									<img
										src={characterImages[c.id]}
										alt={c.name}
										class="g-char-card-img"
									/>
								</div>
							</div>
							<span class="g-char-name">{c.name}</span>
						</button>
					))}
				</div>
				<button type="button" class="g-char-nav g-char-nav-next" aria-label="Nächste Person">
					<span aria-hidden="true">›</span>
				</button>
			</div>

			<!-- MOBILE SLIDER (shown only on mobile) -->
			<div class="g-mobile-slider">
				<div class="g-mobile-slider-track">
					{characters.map((c, index) => (
						<div
							class:list={['g-mobile-card', { 'is-active': index === 0 }]}
							data-char={c.id}
							data-index={index}
						>
							<div class="g-mobile-card-visual">
								<div class="g-mobile-card-bg" aria-hidden="true"></div>
								<img src={characterImages[c.id]} alt={c.name} class="g-mobile-card-img" />
							</div>
							<span class="g-mobile-card-name">{c.name}</span>
						</div>
					))}
				</div>
				<div class="g-mobile-nav">
					<button type="button" class="g-mobile-nav-btn g-mobile-prev" aria-label="Vorherige Person">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M15 18l-6-6 6-6"></path>
						</svg>
					</button>
					<div class="g-mobile-dots">
						{characters.map((c, index) => (
							<div
								class:list={['g-mobile-dot', { 'is-active': index === 0 }]}
								data-index={index}
							>
							</div>
						))}
					</div>
					<button type="button" class="g-mobile-nav-btn g-mobile-next" aria-label="Nächste Person">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M9 18l6-6-6-6"></path>
						</svg>
					</button>
				</div>
			</div>

			<div class="g-char-info">
				<span class="g-eyebrow g-char-role-label">Leitet den Workshop</span>
				<p class="g-char-desc">
					Malte liebt es, andere dabei zu unterstützen, glücklich und unbeschwerter zu werden. Aufgrund seiner Depression gelingt ihm das allerdings im eigenen Alltag immer seltener.
				</p>
			</div>
		</div>
	</section>

	<!-- 4. VIDEO (Off-White) -->
	<section class="g-video">
		<div class="g-video-inner">
			<h2>Buchtrailer</h2>
			<div class="g-video-placeholder" aria-hidden="true">
				<span class="g-play-icon" aria-hidden="true">▶</span>
			</div>
		</div>
	</section>

	<!-- 5. NETFLIX (Off-White) -->
	<section class="g-netflix">
		<div class="g-netflix-inner">
			<h2>Wie Netflix – nur als Buch</h2>
			<div class="g-netflix-grid">
				<div class="g-netflix-col">
					<h3 class="g-netflix-title">Kurze Kapitel</h3>
					<p class="g-netflix-text">Schneller Einstieg und einfaches Lesen für geübte und ungeübte Leser*innen</p>
				</div>
				<div class="g-netflix-col">
					<h3 class="g-netflix-title">Vier Perspektiven</h3>
					<p class="g-netflix-text">Handlung, Gefühle und Emotionen der vier Hauptfiguren hautnah miterleben</p>
				</div>
				<div class="g-netflix-col">
					<h3 class="g-netflix-title">Abwechslung</h3>
					<p class="g-netflix-text">Perspektivwechsel garantiert Spannung und packende Unterhaltung</p>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA: cover + primary button -->
	<section class="g-cta">
		<div class="g-cta-inner">
			<div class="g-cta-cover-wrap">
				<img
					src="/images/sie-wollten-doch-nur-gluecklich-sein.png"
					alt="Buchcover: Sie wollten doch nur glücklich sein"
					class="g-cta-cover"
				/>
			</div>
			<a href="https://www.amazon.de/wollten-doch-gl%C3%BCcklich-Generation-Millennials/dp/B0CKGWZ2WG/ref=tmm_pap_swatch_0" class="btn btn-primary g-cta-btn" target="_blank" rel="noopener noreferrer">Jetzt bestellen</a>
		</div>
	</section>
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const container = document.querySelector('.g-characters');
		const workshop = document.querySelector('.g-workshop');
		const roleLabel = workshop?.querySelector('.g-char-role-label') ?? document.querySelector('.g-char-role-label');
		const descEl = workshop?.querySelector('.g-char-desc') ?? document.querySelector('.g-char-desc');

		if (!container) return;

		let cards = Array.from(container.querySelectorAll('.g-char-card'));
		const isNarrowMobile = window.matchMedia('(max-width: 768px)').matches;
		const isTabletSlider = window.matchMedia('(max-width: 1024px)').matches && !isNarrowMobile;
		let setWidth = null;
		let setStart = null;

		const data = {
			malte: {
				role: 'Leitet den Workshop',
				description:
					'Malte liebt es, andere dabei zu unterstützen, glücklich und unbeschwerter zu werden. Aufgrund seiner Depression gelingt ihm das allerdings im eigenen Alltag immer seltener.',
			},
			lea: {
				role: 'Sucht die große Liebe',
				description:
					'Lea möchte vor ihrem 30. Geburtstag unbedingt einen Partner finden. Bis jetzt stolpert sie von einem Online-Date ins nächste und verliert dabei so langsam ihren Optimismus.',
			},
			elias: {
				role: 'Sucht einen erfüllenden Job',
				description:
					'Elias will endlich wieder Spaß am Arbeiten haben, weiß aber nicht, wonach er suchen soll. Aus Angst vor Veränderung verharrt er seit Jahren in seinem ungeliebten Bürojob.',
			},
			sofia: {
				role: 'Liebt die Karriere',
				description:
					'Sofia ist die jüngste Senior Sales Managerin bei einem führenden eCommerce-Anbieter. Dafür hat sie in den vergangenen Jahren hart gearbeitet – und auf vieles verzichtet.',
			},
		};

		function selectChar(id) {
			const allCards = Array.from(container.querySelectorAll('.g-char-card'));
			allCards.forEach((btn) => {
				const isSelected = btn.dataset.char === id;
				btn.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
				btn.classList.toggle('is-active', isSelected);
				btn.classList.toggle('is-centered', isSelected);
			});
			const charData = data[id];
			if (charData) {
				if (roleLabel) roleLabel.textContent = charData.role;
				if (descEl) descEl.textContent = charData.description;
			}
		}

		function centerCard(card, behavior = 'smooth') {
			const containerWidth = container.offsetWidth;
			const cardLeft = card.offsetLeft;
			const cardWidth = card.offsetWidth;
			const scrollLeft = cardLeft - containerWidth / 2 + cardWidth / 2;
			if (behavior === 'smooth') {
				container.scrollTo({ left: scrollLeft, behavior: 'smooth' });
			} else {
				container.scrollLeft = scrollLeft;
			}
		}

		function getClosestCardToViewportCenter() {
			const allCards = Array.from(container.querySelectorAll('.g-char-card'));
			const containerRect = container.getBoundingClientRect();
			const cx = containerRect.left + containerRect.width / 2;
			let best = null;
			let bestDist = Infinity;
			for (const card of allCards) {
				const r = card.getBoundingClientRect();
				const dist = Math.abs(r.left + r.width / 2 - cx);
				if (dist < bestDist) {
					bestDist = dist;
					best = card;
				}
			}
			return best;
		}

		function navigateAdjacent(delta) {
			if (window.innerWidth > 1024 || window.innerWidth <= 768) return;
			const allCards = Array.from(container.querySelectorAll('.g-char-card'));
			const current = getClosestCardToViewportCenter();
			if (!current || allCards.length === 0) return;
			const idx = allCards.indexOf(current);
			if (idx < 0) return;
			const nextIdx = (idx + delta + allCards.length) % allCards.length;
			const target = allCards[nextIdx];
			const id = target?.dataset?.char;
			if (!target || !id) return;
			ignoreScrollUntil = Date.now() + 400;
			selectChar(id);
			centerCard(target, 'smooth');
		}

		function updateCenteredCard() {
			if (window.innerWidth > 1024 || window.innerWidth <= 768) return;
			const allCards = Array.from(container.querySelectorAll('.g-char-card'));
			const containerRect = container.getBoundingClientRect();
			const containerCenter = containerRect.left + containerRect.width / 2;

			let closestCard = null;
			let closestDistance = Infinity;

			allCards.forEach((card) => {
				const cardRect = card.getBoundingClientRect();
				const cardCenter = cardRect.left + cardRect.width / 2;
				const distance = Math.abs(containerCenter - cardCenter);

				if (distance < closestDistance) {
					closestDistance = distance;
					closestCard = card;
				}
			});

			if (closestCard) {
				const id = closestCard.dataset.char;
				if (id) {
					selectChar(id);
					requestAnimationFrame(() => centerCard(closestCard, 'auto'));
				}
			}
		}

		let ignoreScrollUntil = 0;
		function updateCenteredCardWithGuard() {
			if (Date.now() < ignoreScrollUntil) return;
			updateCenteredCard();
		}

		function setupTabletClones() {
			container.querySelectorAll('[data-clone="true"]').forEach((clone) => clone.remove());
			cards = Array.from(container.querySelectorAll('.g-char-card'));
			if (cards.length !== 4) return;

			const clonesBefore = cards.map((card) => card.cloneNode(true));
			const clonesAfter = cards.map((card) => card.cloneNode(true));

			clonesBefore.reverse().forEach((clone) => {
				clone.setAttribute('data-clone', 'true');
				container.insertBefore(clone, container.firstChild);
			});

			clonesAfter.forEach((clone) => {
				clone.setAttribute('data-clone', 'true');
				container.appendChild(clone);
			});

			cards = Array.from(container.querySelectorAll('.g-char-card'));
			requestAnimationFrame(() => {
				requestAnimationFrame(() => {
					if (cards.length >= 9) {
						setStart = cards[4].offsetLeft;
						setWidth = cards[8].offsetLeft - cards[4].offsetLeft;
						container.style.scrollBehavior = 'auto';
						container.scrollLeft = setStart;
						container.style.scrollBehavior = '';
						const middleMalte = cards[4];
						if (middleMalte) centerCard(middleMalte, 'auto');
					}
				});
			});
		}

		// Tablet (769–1024px): clone cards for infinite scroll strip; narrow mobile uses .g-mobile-slider
		if (isTabletSlider) {
			setupTabletClones();
		}

		// Scroll: infinite loop jump (tablet strip only) then update centered card
		container.addEventListener('scroll', () => {
			if (window.innerWidth <= 768) return;
			const hasClones = container.querySelectorAll('[data-clone="true"]').length > 0;
			if (hasClones && setWidth != null && setStart != null) {
				container.style.scrollBehavior = 'auto';
				if (container.scrollLeft >= setStart + setWidth) {
					container.scrollLeft = container.scrollLeft - setWidth;
				}
				if (container.scrollLeft < setStart) {
					container.scrollLeft = container.scrollLeft + setWidth;
				}
				container.style.scrollBehavior = '';
			}
			window.requestAnimationFrame(updateCenteredCardWithGuard);
		});

		// Click: delegation (works for original and clone cards)
		container.addEventListener('click', (e) => {
			if (window.innerWidth <= 768) return;
			const card = e.target.closest('.g-char-card');
			if (!card) return;
			const id = card.getAttribute('data-char') || card.dataset.char;
			if (!id) return;
			ignoreScrollUntil = Date.now() + 400;
			selectChar(id);
			if (window.innerWidth <= 1024) {
				centerCard(card, 'smooth');
			}
		});

		// Initial selection; mobile centering is done in rAF after cloning
		selectChar('malte');

		const prevBtn = document.querySelector('.g-char-nav-prev');
		const nextBtn = document.querySelector('.g-char-nav-next');
		prevBtn?.addEventListener('click', () => navigateAdjacent(-1));
		nextBtn?.addEventListener('click', () => navigateAdjacent(1));

		const mobileSlider = document.querySelector('.g-mobile-slider');

		function bindMobileSlider() {
			if (!mobileSlider || window.innerWidth > 768 || mobileSlider.dataset.gMobileBound === '1') return;
			mobileSlider.dataset.gMobileBound = '1';

			const mobileCards = Array.from(mobileSlider.querySelectorAll('.g-mobile-card'));
			const mobileDots = Array.from(mobileSlider.querySelectorAll('.g-mobile-dot'));
			const prevM = mobileSlider.querySelector('.g-mobile-prev');
			const nextM = mobileSlider.querySelector('.g-mobile-next');

			let currentIndex = 0;
			const totalCards = mobileCards.length;

			function setMobileActive(index) {
				currentIndex = (index + totalCards) % totalCards;

				const prevIdx = (currentIndex - 1 + totalCards) % totalCards;
				const nextIdx = (currentIndex + 1) % totalCards;

				mobileCards.forEach((card) => {
					card.classList.remove('is-active');
					card.style.display = 'none';
				});

				const prevCard = mobileCards[prevIdx];
				const currentCard = mobileCards[currentIndex];
				const nextCard = mobileCards[nextIdx];

				prevCard.style.display = 'flex';
				prevCard.style.order = '1';

				currentCard.style.display = 'flex';
				currentCard.style.order = '2';
				currentCard.classList.add('is-active');

				nextCard.style.display = 'flex';
				nextCard.style.order = '3';

				mobileDots.forEach((dot, i) => {
					dot.classList.toggle('is-active', i === currentIndex);
				});

				const id = currentCard.dataset.char;
				if (id && data[id]) {
					if (roleLabel) roleLabel.textContent = data[id].role;
					if (descEl) descEl.textContent = data[id].description;
				}
			}

			prevM?.addEventListener('click', () => setMobileActive(currentIndex - 1));
			nextM?.addEventListener('click', () => setMobileActive(currentIndex + 1));

			mobileCards.forEach((card, idx) => {
				card.addEventListener('click', () => {
					if (!card.classList.contains('is-active')) {
						setMobileActive(idx);
					}
				});
			});

			let touchStartX = 0;
			const track = mobileSlider.querySelector('.g-mobile-slider-track');

			track?.addEventListener(
				'touchstart',
				(e) => {
					touchStartX = e.touches[0].clientX;
				},
				{ passive: true }
			);

			track?.addEventListener(
				'touchend',
				(e) => {
					const touchEndX = e.changedTouches[0].clientX;
					const diff = touchStartX - touchEndX;

					if (Math.abs(diff) > 50) {
						if (diff > 0) {
							setMobileActive(currentIndex + 1);
						} else {
							setMobileActive(currentIndex - 1);
						}
					}
				},
				{ passive: true }
			);

			setMobileActive(0);
		}

		window.addEventListener('resize', () => {
			const w = window.innerWidth;
			if (w > 1024 || w <= 768) {
				container.querySelectorAll('[data-clone="true"]').forEach((clone) => clone.remove());
				cards = Array.from(container.querySelectorAll('.g-char-card'));
				setStart = null;
				setWidth = null;
			}
			if (w > 768 && w <= 1024 && container.querySelectorAll('[data-clone="true"]').length === 0) {
				setupTabletClones();
			}
			bindMobileSlider();
		});

		// ========================================
		// MOBILE SLIDER LOGIC (Option 3)
		// ========================================
		bindMobileSlider();
	});
</script>

<style>
	/* Shared */
	.g-eyebrow {
		display: block;
		font-family: 'Manrope', sans-serif;
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.28em;
		color: var(--gold);
		margin: 0 0 0.75rem 0;
	}

	/* Section H2s – default heading style (no eyebrow) */
	.g-workshop-inner h2,
	.g-video-inner h2,
	.g-netflix-inner h2 {
		font-family: 'Manrope', sans-serif;
		font-size: 28px;
		font-weight: 700;
		line-height: 1.1;
		color: var(--text);
		text-transform: none;
		text-align: center;
		margin: 0 0 1rem 0;
	}

	.g-video-inner h2 {
		margin-bottom: 1.5rem;
	}

	.g-netflix-inner h2 {
		margin-bottom: 2.5rem;
	}

	.g-workshop-inner h2 {
		margin-bottom: 1rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: auto;
		padding: 0.85rem 2rem;
		font-family: 'Manrope', sans-serif;
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		border-radius: 9999px;
		cursor: pointer;
		transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
		text-decoration: none;
		white-space: nowrap;
		box-sizing: border-box;
		border: none;
	}

	.btn-primary {
		background-color: var(--btn-primary);
		color: var(--bg);
	}

	.btn-primary:hover {
		background-color: var(--btn-primary-hover);
	}

	/* 1. HERO */
	.g-hero {
		background-color: var(--bg);
		padding: 5rem 0;
	}

	.g-hero-inner {
		max-width: 1100px;
		margin-inline: auto;
		display: grid;
		grid-template-columns: 1fr 1.2fr;
		gap: 3rem;
		align-items: center;
	}

	.g-hero-cover-wrap {
		max-width: 360px;
		overflow: hidden;
	}

	.g-hero-cover {
		width: 100%;
		max-width: 360px;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		display: block;
	}

	.g-hero-content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.g-hero-title {
		font-family: 'Manrope', sans-serif;
		font-size: 42px;
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.02em;
		color: var(--text);
		margin: 0 0 2.5rem;
	}

	@media (max-width: 1024px) {
		.g-hero .g-eyebrow {
			margin-bottom: 1.5rem;
		}
		.g-hero-inner {
