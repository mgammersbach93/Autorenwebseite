<script>
	document.addEventListener('DOMContentLoaded', function () {
		const tabs = document.querySelectorAll('.mw-tab');
		const panels = document.querySelectorAll('.mw-panel');
		const tabList = document.querySelector('.mw-tabs');
		const panelContainer = document.querySelector('.mw-panels-wrap');
		const navPrev = document.querySelector('.mw-nav-prev');
		const navNext = document.querySelector('.mw-nav-next');
		const navPrevNum = navPrev ? navPrev.querySelector('.mw-nav-num') : null;
		const navNextNum = navNext ? navNext.querySelector('.mw-nav-num') : null;
		const total = panels.length;
		let currentIndex = 0;
		const mqStacked = window.matchMedia('(max-width: 1024px)');

		function isStacked() {
			return mqStacked.matches;
		}

		function goToPanel(index) {
			if (isStacked()) return;
			if (index < 0 || index >= total) return;
			currentIndex = index;

			tabs.forEach(function (t, i) {
				t.classList.toggle('mw-tab--active', i === index);
				t.setAttribute('aria-selected', i === index ? 'true' : 'false');
			});
			panels.forEach(function (p, i) {
				p.classList.toggle('mw-panel--active', i === index);
				p.hidden = i !== index;
			});

			if (tabList && tabs[index]) {
				tabs[index].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
			}

			if (navPrev && navNext && navPrevNum && navNextNum) {
				if (index <= 0) {
					navPrev.classList.add('mw-nav-hidden');
				} else {
					navPrev.classList.remove('mw-nav-hidden');
					navPrevNum.textContent = tabs[index - 1].textContent.trim();
				}
				if (index >= total - 1) {
					navNext.classList.add('mw-nav-hidden');
				} else {
					navNext.classList.remove('mw-nav-hidden');
					navNextNum.textContent = tabs[index + 1].textContent.trim();
				}
			}
		}

		function applyLayout() {
			if (isStacked()) {
				panels.forEach(function (p) {
					p.hidden = false;
				});
			} else {
				goToPanel(currentIndex);
			}
		}

		tabs.forEach(function (tab) {
			tab.addEventListener('click', function () {
				if (isStacked()) return;
				const index = tab.getAttribute('data-index');
				if (index !== null) goToPanel(parseInt(index, 10));
			});
		});

		if (navPrev) {
			navPrev.addEventListener('click', function () {
				if (isStacked()) return;
				goToPanel(currentIndex - 1);
			});
		}
		if (navNext) {
			navNext.addEventListener('click', function () {
				if (isStacked()) return;
				goToPanel(currentIndex + 1);
			});
		}

		if (panelContainer) {
			let touchStartX = 0;
			let touchStartY = 0;
			panelContainer.addEventListener('touchstart', function (e) {
				touchStartX = e.touches[0].clientX;
				touchStartY = e.touches[0].clientY;
			}, { passive: true });
			panelContainer.addEventListener('touchend', function (e) {
				if (isStacked()) return;
				var dx = e.changedTouches[0].clientX - touchStartX;
				var dy = e.changedTouches[0].clientY - touchStartY;
				if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
					if (dx < 0) {
						goToPanel(currentIndex + 1);
					} else {
						goToPanel(currentIndex - 1);
					}
				}
			}, { passive: true });
		}

		if (typeof mqStacked.addEventListener === 'function') {
			mqStacked.addEventListener('change', applyLayout);
		} else {
			mqStacked.addListener(applyLayout);
		}

		applyLayout();
	});
</script>
