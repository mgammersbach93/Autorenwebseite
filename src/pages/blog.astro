---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allPosts = await getCollection('blog');
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = posts[0];
const rest = posts.slice(1);

const categoryLabels: Record<string, string> = {
	schreiben: 'Schreiben',
	lesen: 'Lesen',
	'millennial-life': 'Millennial Life',
	persoenlichkeitsentwicklung: 'Persönlichkeitsentwicklung',
};

function formatDate(date: Date) {
	return new Date(date).toLocaleDateString('de-DE', {
		day: 'numeric',
		month: 'long',
		year: 'numeric',
	});
}

function readingTime(body: string) {
	return Math.ceil(body.split(/\s+/).length / 200);
}
---

<Layout title="Blog">
	<!-- 1. HERO -->
	<section class="blog-hero">
		<div class="blog-hero-inner">
			<p class="blog-hero-eyebrow">Blog</p>
			<h1 class="blog-hero-title">Gedanken.<br />Geschichten.<br />Hinter den Kulissen.</h1>
			<p class="blog-hero-subtext">
				Persönliche Essays über das Schreiben, das Lesen und die Fragen, die uns Millennials wirklich beschäftigen.
			</p>
			<a href="#alle-artikel" class="blog-hero-cta">Alle Artikel lesen</a>
			<span class="blog-hero-quote" aria-hidden="true">"</span>
		</div>
	</section>

	<!-- 2. CATEGORY FILTER BAR -->
	<nav class="blog-filter" aria-label="Blog-Kategorien">
		<div class="blog-filter-inner">
			<button class="blog-tab blog-tab--active" data-category="alle">Alle</button>
			<button class="blog-tab" data-category="schreiben">Schreiben</button>
			<button class="blog-tab" data-category="lesen">Lesen</button>
			<button class="blog-tab" data-category="millennial-life">Millennial Life</button>
			<button class="blog-tab" data-category="persoenlichkeitsentwicklung">Persönlichkeitsentwicklung</button>
		</div>
	</nav>

	<!-- 3. FEATURED ARTICLE -->
	{featured && (
		<article class="blog-featured" data-category={featured.data.category} id="alle-artikel">
			<div class="blog-featured-inner">
				<a href={`/blog/${featured.slug}`} class="blog-featured-media">
					{featured.data.image
						? <img src={featured.data.image} alt={featured.data.imageAlt ?? ''} class="blog-featured-img" />
						: <div class="blog-featured-placeholder"></div>
					}
				</a>
				<div class="blog-featured-content">
					<div class="blog-meta">
						<span class="blog-meta-tag">{categoryLabels[featured.data.category]}</span>
						<span class="blog-meta-sep">·</span>
						<time class="blog-meta-date">{formatDate(featured.data.pubDate)}</time>
						<span class="blog-meta-sep">·</span>
						<span class="blog-meta-read">{readingTime(featured.body)} Min. Lesezeit</span>
					</div>
					<h2 class="blog-featured-title">{featured.data.title}</h2>
					<p class="blog-featured-teaser">{featured.data.description}</p>
					<a href={`/blog/${featured.slug}`} class="blog-btn-ghost">Artikel lesen</a>
				</div>
			</div>
		</article>
	)}

	<!-- 4. ARTICLE GRID -->
	<section class="blog-grid-section">
		<div class="blog-grid-inner" id="blog-grid">
			{rest.map((post) => (
				<article class="blog-card" data-category={post.data.category}>
					<a href={`/blog/${post.slug}`} class="blog-card-media-link">
						{post.data.image
							? <img src={post.data.image} alt={post.data.imageAlt ?? ''} class="blog-card-img" />
							: <div class="blog-card-media-placeholder"></div>
						}
					</a>
					<div class="blog-meta">
						<span class="blog-meta-tag">{categoryLabels[post.data.category]}</span>
						<span class="blog-meta-sep">·</span>
						<time class="blog-meta-date">{formatDate(post.data.pubDate)}</time>
						<span class="blog-meta-sep">·</span>
						<span class="blog-meta-read">{readingTime(post.body)} Min. Lesezeit</span>
					</div>
					<h3 class="blog-card-title">
						<a href={`/blog/${post.slug}`}>{post.data.title}</a>
					</h3>
					<p class="blog-card-teaser">{post.data.description}</p>
					<a href={`/blog/${post.slug}`} class="blog-btn-ghost">Artikel lesen</a>
				</article>
			))}

			<!-- Empty state -->
			{rest.length === 0 && (
				<p class="blog-empty">Weitere Artikel folgen bald.</p>
			)}
		</div>
	</section>
</Layout>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const tabs = document.querySelectorAll<HTMLButtonElement>('.blog-tab');
		const featured = document.querySelector<HTMLElement>('.blog-featured');
		const cards = document.querySelectorAll<HTMLElement>('.blog-card');

		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				const category = tab.dataset.category;
				if (!category) return;

				tabs.forEach((t) => t.classList.remove('blog-tab--active'));
				tab.classList.add('blog-tab--active');

				// Filter featured
				if (featured) {
					const show = category === 'alle' || featured.dataset.category === category;
					featured.style.display = show ? '' : 'none';
				}

				// Filter grid cards
				cards.forEach((card) => {
					const show = category === 'alle' || card.dataset.category === category;
					card.style.display = show ? '' : 'none';
				});
			});
		});
	});
</script>

<style>
	:global(.page-main .container) {
		max-width: none;
		padding-inline: 0;
	}

	/* ----- 1. HERO ----- */
	.blog-hero {
		width: 100vw;
		position: relative;
		left: 50%;
		margin-left: -50vw;
		background-color: var(--emerald);
	}

	.blog-hero-inner {
		max-width: 1300px;
		margin-inline: auto;
		padding: 6rem 5rem 5rem;
		position: relative;
	}

	.blog-hero-eyebrow {
		font-family: 'Manrope', sans-serif;
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.28em;
		color: var(--gold);
		margin: 0 0 1.5rem;
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.blog-hero-eyebrow::before {
		content: '';
		display: inline-block;
		width: 2rem;
		height: 2px;
		background-color: var(--gold);
	}

	.blog-hero-title {
		font-family: 'Manrope', sans-serif;
		font-weight: 700;
		font-size: clamp(42px, 6vw, 72px);
		line-height: 1.05;
		letter-spacing: -0.02em;
		color: #f5f0e8;
		max-width: 760px;
		margin: 0 0 1.5rem;
	}

	.blog-hero-subtext {
		font-family: 'Manrope', sans-serif;
		font-weight: 300;
		font-size: 17px;
		line-height: 1.85;
		color: rgba(245, 240, 232, 0.7);
		max-width: 520px;
		margin: 0 0 2rem;
	}

	.blog-hero-cta {
		display: inline-block;
		background-color: var(--gold);
		color: var(--emerald);
		padding: 0.85rem 2rem;
		font-family: 'Manrope', sans-serif;
		font-weight: 700;
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		text-decoration: none;
		transition: background-color 0.25s ease;
	}

	.blog-hero-cta:hover {
		background-color: #c9a84c;
	}

	.blog-hero-quote {
		position: absolute;
		right: 5rem;
		top: 50%;
		transform: translateY(-50%);
		font-family: Georgia, serif;
		font-size: 28rem;
		color: rgba(245, 240, 232, 0.04);
		pointer-events: none;
		line-height: 1;
	}

	/* ----- 2. FILTER BAR ----- */
	.blog-filter {
		width: 100vw;
		position: relative;
		left: 50%;
		margin-left: -50vw;
		background-color: var(--bg);
		border-bottom: 1px solid rgba(28, 28, 28, 0.1);
	}

	.blog-filter-inner {
		max-width: 1300px;
		margin-inline: auto;
		padding: 0 5rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0;
	}

	.blog-tab {
		font-family: 'Manrope', sans-serif;
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: var(--muted);
		padding: 1.1rem 1.5rem;
		background: none;
		border: none;
		border-bottom: 2px solid transparent;
		cursor: pointer;
		transition: color 0.25s ease, border-color 0.25s ease;
	}

	.blog-tab:hover { color: var(--text); }

	.blog-tab--active {
		color: var(--emerald);
		border-bottom-color: var(--gold);
	}

	/* ----- 3. FEATURED ----- */
	.blog-featured {
		max-width: 1300px;
		margin-inline: auto;
		padding: 4rem 5rem;
		border-bottom: 1px solid rgba(28, 28, 28, 0.1);
	}

	.blog-featured-inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: center;
	}

	.blog-featured-media {
		aspect-ratio: 16 / 10;
		display: block;
		overflow: hidden;
	}

	.blog-featured-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.blog-featured-media:hover .blog-featured-img {
		transform: scale(1.03);
	}

	.blog-featured-placeholder {
		width: 100%;
		height: 100%;
		background-color: var(--emerald);
		opacity: 0.4;
	}

	.blog-meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
		margin-bottom: 1rem;
		font-family: 'Manrope', sans-serif;
		font-size: 12px;
	}

	.blog-meta-tag {
		color: var(--gold);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	.blog-meta-sep { color: rgba(28, 28, 28, 0.25); }

	.blog-meta-date,
	.blog-meta-read {
		color: var(--muted);
		font-weight: 300;
	}

	.blog-featured-title {
		font-family: 'Manrope', sans-serif;
		font-weight: 700;
		font-size: clamp(1.5rem, 2.5vw, 2rem);
		line-height: 1.1;
		color: var(--text);
		margin: 0 0 1rem;
	}

	.blog-featured-teaser {
		font-family: 'Manrope', sans-serif;
		font-weight: 300;
		font-size: 15px;
		line-height: 1.85;
		color: var(--muted);
		margin: 0 0 1.5rem;
	}

	.blog-btn-ghost {
		display: inline-block;
		background-color: transparent;
		color: var(--text);
		border: 1px solid rgba(28, 28, 28, 0.2);
		padding: 0.85rem 2rem;
		font-family: 'Manrope', sans-serif;
		font-weight: 700;
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		text-decoration: none;
		transition: border-color 0.25s ease;
	}

	.blog-btn-ghost:hover { border-color: var(--text); }

	/* ----- 4. GRID ----- */
	.blog-grid-section {
		max-width: 1300px;
		margin-inline: auto;
		padding: 4rem 5rem 7rem;
	}

	.blog-grid-inner {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2.5rem;
	}

	.blog-card {
		display: flex;
		flex-direction: column;
	}

	.blog-card-media-link {
		display: block;
		aspect-ratio: 3 / 2;
		overflow: hidden;
		margin-bottom: 1rem;
	}

	.blog-card-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.blog-card-media-link:hover .blog-card-img {
		transform: scale(1.03);
	}

	.blog-card-media-placeholder {
		width: 100%;
		height: 100%;
		background-color: var(--emerald);
		opacity: 0.3;
	}

	.blog-card-title {
		font-family: 'Manrope', sans-serif;
		font-weight: 700;
		font-size: 18px;
		line-height: 1.25;
		color: var(--text);
		margin: 0 0 0.5rem;
	}

	.blog-card-title a {
		text-decoration: none;
		color: inherit;
	}

	.blog-card-title a:hover {
		color: var(--emerald);
	}

	.blog-card-teaser {
		font-family: 'Manrope', sans-serif;
		font-weight: 300;
		font-size: 14px;
		line-height: 1.75;
		color: var(--muted);
		margin: 0 0 1rem;
		flex: 1;
	}

	.blog-empty {
		font-family: 'Manrope', sans-serif;
		font-size: 15px;
		color: var(--muted);
		grid-column: 1 / -1;
	}

	/* Responsive */
	@media (max-width: 960px) {
		.blog-hero-inner,
		.blog-filter-inner,
		.blog-featured,
		.blog-grid-section {
			padding-inline: 2rem;
		}

		.blog-featured-inner {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.blog-grid-inner {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 720px) {
		.blog-hero-inner { padding: 3rem 1.5rem 2.5rem; }
		.blog-filter-inner { padding-inline: 1.5rem; }
		.blog-featured { padding-inline: 1.5rem; }
		.blog-grid-section { padding: 3rem 1.5rem 5rem; }
		.blog-grid-inner { grid-template-columns: 1fr; }
		.blog-hero-quote { display: none; }
	}
</style>
