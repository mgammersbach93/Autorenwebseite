<script>
	if (typeof window !== 'undefined') {
		window.addEventListener('DOMContentLoaded', () => {
			const TESTIMONIALS = [
				{ quote: 'Charaktere zum Identifizieren', author: 'LESERATTE' },
				{ quote: 'Lehrreich, emotional, fesselnd', author: 'MÄRTHE' },
				{ quote: 'Persönlichkeitsentwicklung zum Anfassen!', author: 'DN' },
				{ quote: 'Ein Buch zum Nachdenken', author: 'YANNIC' },
				{ quote: 'Sehr inspirierendes Buch', author: 'KRISTINA' },
			];

			const quoteEl = document.querySelector('.testimonial-quote-lg');
			const authorEl = document.querySelector('.testimonial-author-lg');
			const bars = Array.from(document.querySelectorAll('.testimonial-bar'));

			if (quoteEl && authorEl && bars.length) {
				let current = 0;
				let timerId;
				const ROTATE_MS = 4000;
				const FADE_MS = 400;

				function setActive(index) {
					current = (index + TESTIMONIALS.length) % TESTIMONIALS.length;

					quoteEl.classList.add('testimonial-fade');
					authorEl.classList.add('testimonial-fade');

					window.setTimeout(() => {
						quoteEl.textContent = `„${TESTIMONIALS[current].quote}“`;
						authorEl.textContent = TESTIMONIALS[current].author;
						quoteEl.classList.remove('testimonial-fade');
						authorEl.classList.remove('testimonial-fade');
					}, FADE_MS);

					bars.forEach((bar, i) => {
						const isActive = i === current;
						bar.classList.toggle('is-active', isActive);
						bar.setAttribute('aria-selected', isActive ? 'true' : 'false');
					});

					if (timerId) window.clearTimeout(timerId);
					timerId = window.setTimeout(() => {
						setActive(current + 1);
					}, ROTATE_MS);
				}

				bars.forEach((bar, index) => {
					bar.addEventListener('click', () => {
						setActive(index);
					});
				});

				setActive(0);
			}

			// GALLERY SLIDER
			const track = document.querySelector('.gallery-track');
			const originalSlides = document.querySelectorAll('.gallery-slide');
			const totalSlides = 13;
			let currentIndex = 0;

			// All image paths
			const imageFiles = [
				'/images/galerie/sie-wollten-doch-nur-gluecklich-sein-buecherregal.jpg',
				'/images/galerie/sie-wollten-doch-nur-gluecklich-sein-weihnachtsgeschenk-02a.jpg',
				'/images/galerie/sie-wollten-doch-nur-gluecklich-sein-weihnachtsgeschenk-03a.jpg',
				'/images/galerie/sie-wollten-doch-nur-gluecklich-sein-balkon.jpg',
				'/images/galerie/sie-wollten-doch-nur-gluecklich-sein-bett.jpg',
				'/images/galerie/sie-wollten-doch-nur-gluecklich-sein-buchtipp.jpg',
				'/images/galerie/sie-wollten-doch-nur-gluecklich-sein-flughafen.jpg',
				'/images/galerie/sie-wollten-doch-nur-gluecklich-sein-pool.jpg',
				'/images/galerie/sie-wollten-doch-nur-gluecklich-sein-sonnenschein.jpg',
				'/images/galerie/sie-wollten-doch-nur-gluecklich-sein-strand.jpg',
				'/images/galerie/sie-wollten-doch-nur-gluecklich-sein-therme.jpg',
				'/images/galerie/sie-wollten-doch-nur-gluecklich-sein-weihnachten.jpg',
				'/images/galerie/sie-wollten-doch-nur-gluecklich-sein-zug.jpg'
			];

			if (track && originalSlides.length) {
				// Clone first 4 slides for infinite desktop loop
				for (let i = 0; i < 4; i += 1) {
					const clone = originalSlides[i].cloneNode(true);
					track.appendChild(clone);
				}

				const allSlides = document.querySelectorAll('.gallery-slide');

				function isMobile() {
					return window.innerWidth <= 768;
				}

				// Desktop slide function
				function desktopSlide() {
					currentIndex += 1;
					track.style.transition = 'transform 0.8s ease-in-out';
					track.style.transform = `translateX(-${currentIndex * 25}%)`;

					if (currentIndex >= totalSlides) {
						setTimeout(() => {
							track.style.transition = 'none';
							currentIndex = 0;
							track.style.transform = 'translateX(0)';
						}, 800);
					}
				}

				// Mobile variables
				let mobileSlots = []; // The 4 img elements
				let currentImagesInSlots = [0, 1, 2, 3]; // Track which image index is in each slot
				const changeOrder = [0, 3, 1, 2]; // top-left, bottom-right, top-right, bottom-left
				let changeStep = 0;

				function getNextAvailableImage() {
					// Find an image that's not currently displayed in any slot
					for (let i = 0; i < totalSlides; i += 1) {
						const base = currentImagesInSlots[changeOrder[changeStep]];
						const candidate = (base + 1 + i) % totalSlides;
						if (!currentImagesInSlots.includes(candidate)) {
							return candidate;
						}
					}
					// Fallback: just use the next one
					const base = currentImagesInSlots[changeOrder[changeStep]];
					return (base + 4) % totalSlides;
				}

				function initMobile() {
					track.style.transform = 'none';
					track.style.transition = 'none';

					// Get the first 4 original slides' img elements
					mobileSlots = [];
					for (let i = 0; i < 4; i += 1) {
						const img = originalSlides[i].querySelector('img');
						if (img) {
							img.src = imageFiles[i];
							img.style.opacity = '1';
							mobileSlots.push(img);
						}
					}

					currentImagesInSlots = [0, 1, 2, 3];
					changeStep = 0;
				}

				function mobileFade() {
					const slotIndex = changeOrder[changeStep]; // Which slot to change (0, 3, 1, or 2)
					const imgElement = mobileSlots[slotIndex];

					if (!imgElement) return;

					const nextImageIdx = getNextAvailableImage();

					// Fade out
					imgElement.style.opacity = '0';

					setTimeout(() => {
						// Change image source
						imgElement.src = imageFiles[nextImageIdx];
						currentImagesInSlots[slotIndex] = nextImageIdx;

						// Fade in
						imgElement.style.opacity = '1';

						// Move to next slot in the change order
						changeStep = (changeStep + 1) % 4;
					}, 300);
				}

				// Arrow navigation (desktop only)
				const leftArrow = document.querySelector('.gallery-arrow-left');
				const rightArrow = document.querySelector('.gallery-arrow-right');

				let interval;

				function slideLeft() {
					if (isMobile()) return;

					currentIndex -= 1;
					if (currentIndex < 0) {
						track.style.transition = 'none';
						currentIndex = totalSlides - 1;
						track.style.transform = `translateX(-${currentIndex * 25}%)`;
						// Force reflow
						// eslint-disable-next-line no-unused-expressions
						track.offsetHeight;
						setTimeout(() => {
							track.style.transition = 'transform 0.8s ease-in-out';
						}, 10);
					} else {
						track.style.transition = 'transform 0.8s ease-in-out';
						track.style.transform = `translateX(-${currentIndex * 25}%)`;
					}

					clearInterval(interval);
					interval = setInterval(desktopSlide, 4000);
				}

				function slideRight() {
					if (isMobile()) return;
					desktopSlide();

					clearInterval(interval);
					interval = setInterval(desktopSlide, 4000);
				}

				if (leftArrow) leftArrow.addEventListener('click', slideLeft);
				if (rightArrow) rightArrow.addEventListener('click', slideRight);

				// Initialize and run
				function startGallery() {
					clearInterval(interval);

					if (isMobile()) {
						initMobile();
						interval = setInterval(mobileFade, 2500);
					} else {
						currentIndex = 0;
						track.style.transform = 'translateX(0)';
						interval = setInterval(desktopSlide, 4000);
					}
				}

				startGallery();

				window.addEventListener('resize', () => {
					startGallery();
				});
			}
		});
	}
</script>

<style>
	/* Button Styles – unified across Home page */
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: auto;
		padding: 0.85rem 2rem;
		font-family: 'Manrope', sans-serif;
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		border-radius: 9999px;
		cursor: pointer;
		transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
		text-decoration: none;
		white-space: nowrap;
		box-sizing: border-box;
	}

	/* Primary: Smaragd filled */
	.btn-primary {
		background-color: #1a3a30;
		color: #f5f0e8;
		border: none;
	}

	.btn-primary:hover {
		background-color: #243d35;
	}

	/* Ghost on light background */
	.btn-ghost {
		background-color: transparent;
		color: var(--text);
		border: 1px solid rgba(28, 28, 28, 0.2);
	}

	.btn-ghost:hover {
		border-color: var(--text);
	}

	/* Ghost on dark background (hero, Über mich) */
	.btn-ghost-dark-bg {
		background-color: transparent;
		color: #f5f0e8;
		border: 1px solid rgba(245, 240, 232, 0.4);
	}

	.btn-ghost-dark-bg:hover {
		border-color: #f5f0e8;
	}

	/* Section Styles */
	section {
		padding-block: 7rem;
	}

	.section-title {
		font-family: 'Manrope', sans-serif;
		font-size: 28px;
