---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
	<!-- 1. HERO -->
	<section class="home-hero">
		<div class="container hero-inner">
			<div class="hero-content">
				<h1 class="hero-title">Entdecke<br>deine neuen<br>Seiten</h1>
				<p class="hero-subtext">Bücher, die dich zum Nachdenken bringen</p>
				<a href="#mehr-als-nur-geschichten" class="btn btn-primary hero-cta">Jetzt entdecken</a>
			</div>
			<div class="hero-image-wrapper">
				<div class="hero-image-block"></div>
				<img
					src="/images/entdecke-deine-neuen-seiten-markus-gammersbach.png"
					alt="Markus Gammersbach mit Buch"
					class="hero-image"
					loading="eager"
					fetchpriority="high"
				/>
			</div>
		</div>
	</section>

	<!-- 2. BÜCHER -->
	<section class="home-books" id="mehr-als-nur-geschichten">
		<div class="container books-inner">
			<header class="books-header">
				<h2 class="section-title">Mehr als nur Geschichten</h2>
				<p class="books-subtitle">
					Romane für Veränderung. Erhalte neue Perspektiven und praktische Impulse für deinen Alltag.
				</p>
			</header>
			<div class="books-layout">
				<div class="books-covers">
					<div class="book-item">
						<a href="/buecher" class="book-cover-link">
							<img class="book-cover-img" src="/images/sie-wollten-doch-nur-gluecklich-sein.jpg" alt="Buchcover: Sie wollten doch nur glücklich sein" />
						</a>
						<div class="book-actions">
							<a href="https://www.amazon.de/wollten-doch-gl%C3%BCcklich-Generation-Millennials/dp/B0CKGWZ2WG/ref=tmm_pap_swatch_0" class="book-btn book-btn-primary" target="_blank" rel="noopener noreferrer">Kaufen</a>
							<a href="/gluecklich-sein/" class="book-btn book-btn-ghost">Details</a>
						</div>
					</div>
					<div class="book-item">
						<a href="/buecher" class="book-cover-link">
							<img class="book-cover-img" src="/images/sie-wollten-endlich-neues-wagen.jpg" alt="Buchcover: Sie wollten endlich Neues wagen" />
						</a>
						<div class="book-actions">
							<a href="/neues-wagen/" class="book-btn book-btn-primary">Kaufen</a>
							<a href="/neues-wagen/" class="book-btn book-btn-ghost">Details</a>
						</div>
					</div>
				</div>
				<div class="books-testimonials">
					<p class="books-testimonials-eyebrow">Leserstimmen</p>
					<div class="testimonials-stars">★★★★★</div>
					<figure class="testimonial-spotlight">
						<blockquote class="testimonial-quote-lg"></blockquote>
						<figcaption class="testimonial-author-lg"></figcaption>
					</figure>
					<div class="testimonial-bars" role="tablist" aria-label="Leserstimmen">
						<button type="button" class="testimonial-bar" data-index="0" role="tab" aria-label="Zitat 1"></button>
						<button type="button" class="testimonial-bar" data-index="1" role="tab" aria-label="Zitat 2"></button>
						<button type="button" class="testimonial-bar" data-index="2" role="tab" aria-label="Zitat 3"></button>
						<button type="button" class="testimonial-bar" data-index="3" role="tab" aria-label="Zitat 4"></button>
						<button type="button" class="testimonial-bar" data-index="4" role="tab" aria-label="Zitat 5"></button>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- 4. ÜBER MICH -->
	<section class="home-about">
		<div class="about-inner">
			<div class="about-image">
				<img
					class="about-image-img"
					src="/images/markus-gammersbach-selfpublishing-autor.png"
					alt="Markus Gammersbach, Selfpublishing-Autor"
				/>
			</div>
			<div class="about-content">
				<h2 class="section-title about-title">Über mich</h2>
				<p class="about-text">
					Ich bin Markus und ich liebe es, zu schreiben. Ganz besonders über die Herausforderungen
					meiner Generation und über Persönlichkeitsentwicklung.
				</p>
				<p class="about-text">
					Anders als viele Autorinnen und Autoren schreibe ich nicht schon mein ganzes Leben lang.
					Ich habe meine Leidenschaft fürs Schreiben erst während Corona für mich entdeckt.
				</p>
				<p class="about-text">
					Alles, was es dafür brauchte, war eine Folge Gemischtes Hack, die Suche nach einer
					kreativen Beschäftigung und der Mut, einfach mal etwas Neues auszuprobieren.
				</p>
				<div class="about-cta">
					<a href="/ueber-mich" class="btn btn-ghost-dark-bg">Mehr</a>
				</div>
			</div>
		</div>
	</section>

	<!-- 5. QUOTE BAND (Off-White background, decorative quote) -->
	<section class="home-quote-band">
		<div class="quote-band-inner">
			<span class="quote-mark" aria-hidden="true">„</span>
			<blockquote class="quote-text quote-centered">
				Manchmal reicht ein einziges Wort,<br class="quote-linebreak-desktop" aria-hidden="true" />
				um einen neuen Impuls für den eigenen Alltag zu bekommen.
			</blockquote>
		</div>
	</section>

	<!-- 6. FEATURES: WARUM LESEN & MILLENNIAL WORKSHOP -->
	<section class="features-section">
		<div class="features-grid">
			<div class="feature-item">
				<div class="feature-image-container">
					<div class="feature-shape"></div>
					<img
						src="/images/blaettern-statt-scrollen.png"
						alt="Blättern statt Scrollen"
						class="feature-image"
					/>
				</div>
				<h2>Blättern statt Scrollen</h2>
				<p>
					Lesen ist gesund. Das bestätigen zahlreiche Studien. Hier erfährst du, warum wir häufiger zum
					Buch greifen sollten.
				</p>
				<a href="/warum-lesen" class="feature-button">Blättern</a>
			</div>
			<div class="feature-item">
				<div class="feature-image-container">
					<div class="feature-shape"></div>
					<img
						src="/images/millennial-workshop.png"
						alt="Millennial Workshop"
						class="feature-image"
					/>
				</div>
				<h2>Millennial Workshop</h2>
				<p>
					Wie führt man ein unbeschwertes Leben? Hier erhältst du zehn inspirierende Lektionen für dein
					persönliches Wachstum.
				</p>
				<a href="/millennial-workshop" class="feature-button">Wachsen</a>
			</div>
		</div>
	</section>

	<!-- 8. SOCIAL / KONTAKT -->
	<section class="home-social">
		<div class="container social-inner">
			<h2 class="section-title section-title--center">Folge mir auf Instagram</h2>
		<div class="community-split">
		<div class="gallery-section">
			<div class="gallery-grid">
				<div class="gallery-item">
					<img src="/images/galerie/sie-wollten-doch-nur-gluecklich-sein-buecherregal.jpg" alt="Leser mit Buch" />
				</div>
				<div class="gallery-item">
					<img src="/images/galerie/sie-wollten-doch-nur-gluecklich-sein-weihnachtsgeschenk-02a.jpg" alt="Leser mit Buch" />
				</div>
				<div class="gallery-item">
					<img src="/images/galerie/sie-wollten-doch-nur-gluecklich-sein-weihnachtsgeschenk-03a.jpg" alt="Leser mit Buch" />
				</div>
				<div class="gallery-item">
					<img src="/images/galerie/sie-wollten-doch-nur-gluecklich-sein-balkon.jpg" alt="Leser mit Buch" />
				</div>
			</div>
		</div>
		<div class="community-divider"></div>
		<div class="insta-card">
			<div class="insta-avatar">
				<div class="insta-avatar-inner">
					<img
						src="/images/deine-neuen-seiten-instagram.png"
						alt="Deine neuen Seiten"
						class="insta-avatar-img"
					/>
				</div>
			</div>
			<div class="insta-info">
				<p class="insta-handle">@deine.neuen.seiten</p>
				<p class="insta-tagline">Inspiration für zwischendurch</p>
			</div>
			<a
				href="https://www.instagram.com/deine.neuen.seiten/"
				class="btn btn-ghost insta-btn"
				target="_blank"
				rel="noopener noreferrer"
			>Folgen</a>
		</div>
		</div>
		</div>
	</section>
</Layout>

<script>
	if (typeof window !== 'undefined') {
		window.addEventListener('DOMContentLoaded', () => {
			const TESTIMONIALS = [
				{ quote: 'Charaktere zum Identifizieren', author: 'LESERATTE' },
				{ quote: 'Lehrreich, emotional, fesselnd', author: 'MÄRTHE' },
				{ quote: 'Persönlichkeitsentwicklung zum Anfassen!', author: 'DN' },
				{ quote: 'Ein Buch zum Nachdenken', author: 'YANNIC' },
				{ quote: 'Sehr inspirierendes Buch', author: 'KRISTINA' },
			];

			const quoteEl = document.querySelector('.testimonial-quote-lg');
			const authorEl = document.querySelector('.testimonial-author-lg');
			const bars = Array.from(document.querySelectorAll('.testimonial-bar'));

			if (quoteEl && authorEl && bars.length) {
				let current = 0;
				let timerId;
				const ROTATE_MS = 4000;
				const FADE_MS = 400;

				function setActive(index) {
					current = (index + TESTIMONIALS.length) % TESTIMONIALS.length;

					quoteEl.classList.add('testimonial-fade');
					authorEl.classList.add('testimonial-fade');

					window.setTimeout(() => {
						quoteEl.textContent = `„${TESTIMONIALS[current].quote}“`;
						authorEl.textContent = TESTIMONIALS[current].author;
						quoteEl.classList.remove('testimonial-fade');
						authorEl.classList.remove('testimonial-fade');
					}, FADE_MS);

					bars.forEach((bar, i) => {
						const isActive = i === current;
						bar.classList.toggle('is-active', isActive);
						bar.setAttribute('aria-selected', isActive ? 'true' : 'false');
					});

					if (timerId) window.clearTimeout(timerId);
					timerId = window.setTimeout(() => {
						setActive(current + 1);
					}, ROTATE_MS);
				}

				bars.forEach((bar, index) => {
					bar.addEventListener('click', () => {
						setActive(index);
					});
				});

				setActive(0);
			}

			// GALLERY AUTO-ROTATE (2×2 grid, all viewports)
			const galleryItems = document.querySelectorAll('.gallery-item img');
			const imageFiles = [
				'/images/galerie/sie-wollten-doch-nur-gluecklich-sein-buecherregal.jpg',
				'/images/galerie/sie-wollten-doch-nur-gluecklich-sein-weihnachtsgeschenk-02a.jpg',
				'/images/galerie/sie-wollten-doch-nur-gluecklich-sein-weihnachtsgeschenk-03a.jpg',
				'/images/galerie/sie-wollten-doch-nur-gluecklich-sein-balkon.jpg',
				'/images/galerie/sie-wollten-doch-nur-gluecklich-sein-bett.jpg',
				'/images/galerie/sie-wollten-doch-nur-gluecklich-sein-buchtipp.jpg',
				'/images/galerie/sie-wollten-doch-nur-gluecklich-sein-flughafen.jpg',
				'/images/galerie/sie-wollten-doch-nur-gluecklich-sein-pool.jpg',
				'/images/galerie/sie-wollten-doch-nur-gluecklich-sein-sonnenschein.jpg',
				'/images/galerie/sie-wollten-doch-nur-gluecklich-sein-strand.jpg',
				'/images/galerie/sie-wollten-doch-nur-gluecklich-sein-therme.jpg',
				'/images/galerie/sie-wollten-doch-nur-gluecklich-sein-weihnachten.jpg',
				'/images/galerie/sie-wollten-doch-nur-gluecklich-sein-zug.jpg',
			];
			const totalSlides = imageFiles.length;
			const ROTATE_MS = 2500;

			if (galleryItems.length === 4) {
				const slots = Array.from(galleryItems);
				let currentImagesInSlots = [0, 1, 2, 3];
				const changeOrder = [0, 3, 1, 2];
				let changeStep = 0;

				function getNextAvailableImage() {
					for (let i = 0; i < totalSlides; i += 1) {
						const base = currentImagesInSlots[changeOrder[changeStep]];
						const candidate = (base + 1 + i) % totalSlides;
						if (!currentImagesInSlots.includes(candidate)) {
							return candidate;
						}
					}
					const base = currentImagesInSlots[changeOrder[changeStep]];
					return (base + 4) % totalSlides;
				}

				function rotateOne() {
					const slotIndex = changeOrder[changeStep];
					const imgEl = slots[slotIndex];
					if (!imgEl) return;

					const nextIdx = getNextAvailableImage();
					imgEl.style.opacity = '0';

					window.setTimeout(() => {
						imgEl.src = imageFiles[nextIdx];
						currentImagesInSlots[slotIndex] = nextIdx;
						imgEl.style.opacity = '1';
						changeStep = (changeStep + 1) % 4;
					}, 300);
				}

				window.setInterval(rotateOne, ROTATE_MS);
			}
		});
	}
</script>

<style>
	/* Button Styles – unified across Home page */
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: auto;
		padding: 0.85rem 2rem;
		font-family: 'Manrope', sans-serif;
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		border-radius: 9999px;
		cursor: pointer;
		transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
		text-decoration: none;
		white-space: nowrap;
		box-sizing: border-box;
	}

	/* Primary: accent filled */
	.btn-primary {
		background-color: var(--btn-primary);
		color: #f5f0e8;
		border: none;
	}

	.btn-primary:hover {
		background-color: var(--btn-primary-hover);
	}

	/* Ghost on light background */
	.btn-ghost {
		background-color: transparent;
		color: var(--text);
		border: 1px solid rgba(28, 28, 28, 0.2);
	}

	.btn-ghost:hover {
		border-color: var(--text);
	}

	/* Ghost on dark background (hero, Über mich) */
	.btn-ghost-dark-bg {
		background-color: transparent;
		color: #f5f0e8;
		border: 1px solid rgba(245, 240, 232, 0.4);
	}

	.btn-ghost-dark-bg:hover {
		border-color: #f5f0e8;
	}

	/* Section Styles */
	section {
		padding-block: 7rem;
	}

	.section-title {
		font-family: 'Manrope', sans-serif;
		font-size: 28px;
		font-weight: 700;
		line-height: 1.1;
		margin: 0 0 var(--space-4);
		color: var(--text);
	}

	/* 1. HERO – two-column layout */
	.home-hero {
		background-color: var(--bg);
		padding-block: 7rem;
		min-height: 80vh;
		display: flex;
		align-items: center;
	}

	.hero-inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		align-items: center;
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.hero-title {
		font-family: 'Manrope', sans-serif;
		font-size: 72px;
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.02em;
		margin: 0;
		color: var(--text);
	}

	.hero-subtext {
		font-family: 'Manrope', sans-serif;
		font-size: 16px;
		font-weight: 300;
		line-height: 1.7;
		color: #888880;
		max-width: 360px;
		margin-top: 1.25rem;
		margin-bottom: 1.75rem;
	}

	.hero-cta {
		display: inline-block;
		width: auto;
	}

	.hero-image-wrapper {
		position: relative;
		display: flex;
		justify-content: center;
		align-items: flex-end;
		padding: 0;
	}

	.hero-image-block {
		position: absolute;
		bottom: 0;
		left: 50%;
		transform: translateX(-50%);
		width: 380px;
		height: 380px;
		background-color: var(--emerald);
		z-index: 1;
		border-radius: 60px 60px 0 0;
	}

	.hero-image {
		position: relative;
		z-index: 2;
		width: 100%;
		max-width: 480px;
		height: auto;
	}

	/* 2. BÜCHER – centered header, covers + testimonials side by side */
	.home-books {
		background-color: var(--bg);
		padding-block: 4rem 7rem;
		overflow: visible;
	}

	#mehr-als-nur-geschichten {
		scroll-margin-top: 120px;
	}

	.books-inner {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.books-header {
		text-align: center;
	}

	.books-eyebrow {
		font-family: 'Manrope', sans-serif;
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.28em;
		color: var(--gold);
		margin: 0 0 1rem;
	}

	.books-header .section-title {
		margin-bottom: 1rem;
	}

	.books-subtitle {
		font-family: 'Manrope', sans-serif;
		font-size: 16px;
		font-weight: 300;
		line-height: 1.7;
		color: var(--muted);
		max-width: 700px;
		margin: 0 auto;
	}

	.books-layout {
		display: flex;
		justify-content: flex-start;
		gap: 4rem;
		align-items: stretch;
		width: fit-content;
		margin-inline: auto;
		overflow: visible;
	}

	.books-covers {
		display: flex;
		gap: 1.5rem;
		overflow: visible;
	}

	.home-books .books-inner {
		overflow: visible;
	}

	.book-item {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.book-cover-link {
		display: block;
	}

	.book-cover-img {
		width: 220px;
		height: 330px;
		object-fit: cover;
		display: block;
	}

	.book-actions {
		margin-top: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		align-items: center;
	}

	.book-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.85rem 2rem;
		font-family: 'Manrope', sans-serif;
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		border-radius: 9999px;
		width: 140px;
		text-align: center;
		text-decoration: none;
		box-sizing: border-box;
	}

	.book-btn-primary {
		background-color: var(--btn-primary);
		color: #f5f0e8;
		border: none;
	}

	.book-btn-primary:hover {
		background-color: var(--btn-primary-hover);
	}

	.books-covers .book-item:last-child .book-btn-primary {
		background-color: #C13A00;
	}

	.books-covers .book-item:last-child .book-btn-primary:hover {
		background-color: #a83200;
	}

	.book-btn-ghost {
		background-color: transparent;
		color: #1c1c1c;
		border: 1px solid rgba(28, 28, 28, 0.25);
	}

	.book-btn-ghost:hover {
		background-color: rgba(28, 28, 28, 0.05);
	}

	.books-testimonials {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding-left: 2rem;
		width: 320px;
		flex-shrink: 0;
		margin-top: -7rem;
		position: relative;
	}

	.books-testimonials::before {
		content: '';
		position: absolute;
		left: 0;
		top: 7rem;
		bottom: 0;
		width: 1px;
		background-color: var(--gold);
	}

	.books-testimonials-eyebrow {
		font-family: 'Manrope', sans-serif;
		font-size: 10px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.25em;
		color: var(--muted);
		margin: 0 0 0.5rem;
	}

	.testimonials-stars {
		font-size: 14px;
		color: var(--gold);
		letter-spacing: 4px;
		margin-bottom: 1.5rem;
	}

	.testimonial-spotlight {
		margin: 0;
		min-height: 100px;
	}

	.testimonial-quote-lg {
		font-family: 'Manrope', sans-serif;
		font-size: 20px;
		font-weight: 300;
		font-style: italic;
		line-height: 1.45;
		margin: 0;
		color: var(--text);
		transition: opacity 0.4s ease;
	}

	.testimonial-author-lg {
		font-family: 'Manrope', sans-serif;
		font-size: 10px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.3em;
		margin-top: 1rem;
		color: var(--muted);
		transition: opacity 0.4s ease;
	}

	.testimonial-fade {
		opacity: 0;
	}

	.testimonial-bars {
		display: flex;
		gap: 0.5rem;
		margin-top: 2rem;
	}

	.testimonial-bar {
		width: 40px;
		height: 2px;
		background-color: rgba(28, 28, 28, 0.15);
		border: none;
		padding: 0;
		cursor: pointer;
		position: relative;
		overflow: hidden;
	}

	.testimonial-bar::after {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		height: 100%;
		width: 0;
		background-color: var(--gold);
	}

	.testimonial-bar.is-active::after {
		animation: bar-fill 4s linear forwards;
	}

	@keyframes bar-fill {
		from { width: 0; }
		to { width: 100%; }
	}

	.books-cta {
		text-align: center;
	}

	/* 4. ÜBER MICH – image left, text right */
	.home-about {
		width: 100vw;
		margin-left: calc(50% - 50vw);
		background-color: var(--emerald);
		color: #f5f0e8;
		padding-top: 2rem;
		padding-bottom: 2rem;
		box-sizing: border-box;
